<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="BdoComboSetup.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    >

    <!-- Translucent system backdrop; the glass gradient below covers it, the tint on top keeps the glass look. -->
    <Window.SystemBackdrop>
        <DesktopAcrylicBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Decorative backdrop behind everything: the gradient base with the accent, mint and rose glows, then the window tint. -->
        <Grid Grid.RowSpan="4">
            <Border Background="{ThemeResource GlassBackdropBrush}" />
            <Border Background="{ThemeResource GlassGlowAccentBrush}" />
            <Border Background="{ThemeResource GlassGlowMintBrush}" />
            <Border Background="{ThemeResource GlassGlowRoseBrush}" />
        </Grid>
        <Border Grid.RowSpan="4" Background="{ThemeResource GlassWindowTintBrush}" />

        <!-- Custom title bar: the window content extends into it (AppWindow.TitleBar). Its content holds the logo chip, the tabs (Combos, Editor)
             and, at the right, the context of the page with its primary action; the Settings gear sits in the right header, next to the caption buttons. -->
        <TitleBar x:Name="AppTitleBar" IsBackButtonVisible="False" IsPaneToggleButtonVisible="False">
            <TitleBar.Resources>
                <!-- The template keeps a minimum drag strip between the right header and the caption buttons; with it the Settings
                     button floated away from them. The title content is a drag region anyway, so the strip is not needed. -->
                <x:Double x:Key="TitleBarMinDragRegionWidth">0</x:Double>
                <!-- The right header is centered in the title bar row by default, which puts the Settings button lower than the caption
                     buttons; top-aligned, its 32 px height lines up with them. -->
                <VerticalAlignment x:Key="TitleBarRightHeaderVerticalAlignment">Stretch</VerticalAlignment>
                <!-- The content fills the bar: the logo chip and the tabs at the left edge, the page context and its action at the right. -->
                <HorizontalAlignment x:Key="TitleBarContentHorizontalAlignment">Stretch</HorizontalAlignment>
            </TitleBar.Resources>
            <TitleBar.Content>
                <Grid Margin="4,0,8,0" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border
                        Width="26"
                        Height="26"
                        VerticalAlignment="Center"
                        CornerRadius="9"
                        Background="{ThemeResource AccentGradientBrush}">
                        <TextBlock
                            Text="B"
                            FontSize="11"
                            FontWeight="Bold"
                            Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />
                    </Border>

                    <!-- The two destinations of the app. The selected one has the accent underline. The tabs are interactive, so they are
                         taken out of the drag region explicitly. Their selection follows the page (see ShowNavigationState). -->
                    <SelectorBar
                        x:Name="MainTabs"
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        TitleBar.IsDragRegion="False"
                        SelectionChanged="MainTabs_SelectionChanged">
                        <SelectorBarItem x:Name="CombosTab" x:Uid="Shell/TabCombos" />
                        <SelectorBarItem x:Name="EditorTab" x:Uid="Shell/TabEditor" />
                    </SelectorBar>
                </Grid>
            </TitleBar.Content>
            <TitleBar.RightHeader>
                <!-- The Settings gear: a third destination. While Settings is shown it is marked (the Selected state: accent glyph and underline).
                     Its name and tooltip are set in code-behind. -->
                <Grid x:Name="SettingsSlot" Width="46" Height="48">
                    <Button
                        x:Name="SettingsButton"
                        Margin="0"
                        Width="46"
                        Height="48"
                        MinWidth="0"
                        MinHeight="0"
                        Padding="0"
                        CornerRadius="0"
                        VerticalAlignment="Stretch"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="Settings_Click">
                        <!-- The thin gear of Segoe Fluent Icons at the size of the caption button glyphs, so it reads as one of them. -->
                        <FontIcon x:Name="SettingsIcon" Glyph="&#xE713;" FontSize="14" />
                    </Button>
                    <Border
                        x:Name="SettingsUnderline"
                        Width="16"
                        Height="3"
                        Margin="0,0,0,1"
                        CornerRadius="2"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Bottom"
                        Background="{ThemeResource AccentFillColorDefaultBrush}"
                        IsHitTestVisible="False"
                        Visibility="Collapsed" />
                </Grid>
            </TitleBar.RightHeader>
        </TitleBar>

        <!-- Update banner: shown when a newer release exists (never installs by itself; the buttons do). -->
        <InfoBar
            x:Name="UpdateBar"
            Grid.Row="1"
            Margin="12,8,12,0"
            Severity="Informational"
            IsClosable="True"
            IsOpen="{x:Bind Updates.IsBannerOpen, Mode=OneWay}"
            Title="{x:Bind Updates.BannerTitle, Mode=OneWay}"
            Message="{x:Bind Updates.BannerMessage, Mode=OneWay}"
            Closed="UpdateBar_Closed">
            <!-- The primary action is the InfoBar's action button; the others sit under the message. -->
            <InfoBar.ActionButton>
                <Button
                    Command="{x:Bind Updates.InstallCommand}"
                    Content="{x:Bind Updates.InstallActionText, Mode=OneWay}"
                    Style="{StaticResource AccentButtonStyle}" />
            </InfoBar.ActionButton>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Uid="UpdateBar/NotesButton" Click="UpdateNotes_Click" />
                <Button
                    x:Uid="UpdateBar/CancelButton"
                    Command="{x:Bind Updates.CancelDownloadCommand}"
                    IsEnabled="{x:Bind Updates.CanCancelDownload, Mode=OneWay}" />
                <Button x:Uid="UpdateBar/LaterButton" Command="{x:Bind Updates.DismissCommand}" />
            </StackPanel>
        </InfoBar>

        <!-- The pages are shown here; the code-behind navigates (there is no side menu). -->
        <Frame x:Name="ContentFrame" Grid.Row="2" />

        <!-- Thin status bar: the game state on the left (polled by the code-behind, never a capture). -->
        <Border
            Grid.Row="3"
            Padding="22,6"
            Background="{ThemeResource GlassStatusBarBrush}"
            BorderBrush="{ThemeResource GlassLineBrush}"
            BorderThickness="0,1,0,0">
            <Grid>
                <StackPanel
                    x:Name="GameDetectedGroup"
                    Orientation="Horizontal"
                    Spacing="8"
                    VerticalAlignment="Center"
                    Visibility="Collapsed">
                    <Ellipse
                        Width="8"
                        Height="8"
                        VerticalAlignment="Center"
                        Fill="{ThemeResource GlassSuccessBrush}" />
                    <TextBlock
                        x:Name="GameDetectedText"
                        FontSize="12"
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource GlassSuccessBrush}" />
                </StackPanel>

                <StackPanel
                    x:Name="GameNotDetectedGroup"
                    Orientation="Horizontal"
                    Spacing="8"
                    VerticalAlignment="Center">
                    <Ellipse
                        Width="8"
                        Height="8"
                        VerticalAlignment="Center"
                        Fill="{ThemeResource GlassMutedTextBrush}" />
                    <TextBlock
                        x:Name="GameNotDetectedText"
                        FontSize="12"
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource GlassMutedTextBrush}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
