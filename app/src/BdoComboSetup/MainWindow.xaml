<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="BdoComboSetup.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:BdoComboSetup.Views"
    xmlns:controls="using:BdoComboSetup.Views.Controls"
    xmlns:combo="using:BdoComboSetup.Core.Combo"
    >

    <!-- Translucent system backdrop; the glass gradient below covers it, the tint on top keeps the glass look. -->
    <Window.SystemBackdrop>
        <DesktopAcrylicBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Decorative backdrop behind everything: the gradient base with the accent, mint and rose glows, then the window tint. -->
        <Grid Grid.RowSpan="4">
            <Border Background="{ThemeResource GlassBackdropBrush}" />
            <Border Background="{ThemeResource GlassGlowAccentBrush}" />
            <Border Background="{ThemeResource GlassGlowMintBrush}" />
            <Border Background="{ThemeResource GlassGlowRoseBrush}" />
        </Grid>
        <Border Grid.RowSpan="4" Background="{ThemeResource GlassWindowTintBrush}" />

        <!-- Custom title bar: the window content extends into it (AppWindow.TitleBar). The logo chip and the title sit in its content. -->
        <TitleBar x:Name="AppTitleBar" IsBackButtonVisible="False" IsPaneToggleButtonVisible="False">
            <TitleBar.Content>
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center" Margin="4,0,0,0">
                    <Border
                        Width="26"
                        Height="26"
                        CornerRadius="9"
                        Background="{ThemeResource AccentGradientBrush}">
                        <TextBlock
                            Text="B"
                            FontSize="11"
                            FontWeight="Bold"
                            Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />
                    </Border>
                    <TextBlock
                        x:Name="TitleText"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                        VerticalAlignment="Center" />
                </StackPanel>
            </TitleBar.Content>
        </TitleBar>

        <!-- Update banner: shown when a newer release exists (never installs by itself; the buttons do). -->
        <InfoBar
            x:Name="UpdateBar"
            Grid.Row="1"
            Margin="12,8,12,0"
            Severity="Informational"
            IsClosable="True"
            IsOpen="{x:Bind Updates.IsBannerOpen, Mode=OneWay}"
            Title="{x:Bind Updates.BannerTitle, Mode=OneWay}"
            Message="{x:Bind Updates.BannerMessage, Mode=OneWay}"
            Closed="UpdateBar_Closed">
            <!-- The primary action is the InfoBar's action button; the others sit under the message. -->
            <InfoBar.ActionButton>
                <Button
                    Command="{x:Bind Updates.InstallCommand}"
                    Content="{x:Bind Updates.InstallActionText, Mode=OneWay}"
                    Style="{StaticResource AccentButtonStyle}" />
            </InfoBar.ActionButton>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Uid="UpdateBar/NotesButton" Click="UpdateNotes_Click" />
                <Button
                    x:Uid="UpdateBar/CancelButton"
                    Command="{x:Bind Updates.CancelDownloadCommand}"
                    IsEnabled="{x:Bind Updates.CanCancelDownload, Mode=OneWay}" />
                <Button x:Uid="UpdateBar/LaterButton" Command="{x:Bind Updates.DismissCommand}" />
            </StackPanel>
        </InfoBar>

        <!-- No toggle button: the menu is an overlay (LeftMinimal) that the edge handle below opens. The Settings page can switch to a
             permanently open menu (Left); the code-behind sets the mode from the saved setting. -->
        <NavigationView
            x:Name="Nav"
            Grid.Row="2"
            PaneDisplayMode="LeftMinimal"
            IsPaneOpen="False"
            IsPaneToggleButtonVisible="False"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            OpenPaneLength="220"
            SelectionChanged="Nav_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="ApplyItem" x:Uid="NavApplyItem" Tag="apply" MinHeight="46" CornerRadius="8" LostFocus="MenuItem_LostFocus">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Accept" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="PreviewItem" x:Uid="NavPreviewItem" Tag="preview" MinHeight="46" CornerRadius="8" LostFocus="MenuItem_LostFocus">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="View" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <NavigationView.FooterMenuItems>
                <NavigationViewItem x:Name="SettingsItem" x:Uid="NavSettingsItem" Tag="settings" MinHeight="46" CornerRadius="8" LostFocus="MenuItem_LostFocus">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Setting" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <NavigationView.Content>
                <Frame x:Name="ContentFrame" />
            </NavigationView.Content>
        </NavigationView>

        <!-- Edge handle: a thin transparent strip over the left edge of the content, with a short accent bar. Pointer or keyboard focus
             on it opens the menu; it is collapsed when the menu stays visible, on the setup and on the asset error page. -->
        <Button
            x:Name="EdgeHandle"
            x:Uid="NavEdgeHandle"
            Grid.Row="2"
            Width="12"
            MinWidth="0"
            MinHeight="0"
            Padding="0"
            HorizontalAlignment="Left"
            VerticalAlignment="Stretch"
            HorizontalContentAlignment="Stretch"
            VerticalContentAlignment="Stretch"
            Background="Transparent"
            BorderThickness="0"
            Visibility="Collapsed"
            PointerEntered="EdgeHandle_PointerEntered"
            PointerExited="EdgeHandle_PointerExited"
            GotFocus="EdgeHandle_GotFocus"
            LostFocus="EdgeHandle_LostFocus"
            Click="EdgeHandle_Click">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <!-- No visual states: the strip stays invisible apart from the handle, with no hover highlight. -->
                    <Border Background="{TemplateBinding Background}">
                        <ContentPresenter
                            Content="{TemplateBinding Content}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>
                </ControlTemplate>
            </Button.Template>
            <Border
                Width="4"
                Height="64"
                Margin="4,0,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                CornerRadius="2"
                Opacity="0.6"
                Background="{ThemeResource AccentFillColorDefaultBrush}"
                IsHitTestVisible="False" />
        </Button>

        <!-- Thin status bar: the game state on the left (polled by the code-behind, never a capture), the app version on the right. -->
        <Border
            Grid.Row="3"
            Padding="22,6"
            Background="{ThemeResource GlassStatusBarBrush}"
            BorderBrush="{ThemeResource GlassLineBrush}"
            BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel
                    x:Name="GameDetectedGroup"
                    Orientation="Horizontal"
                    Spacing="8"
                    VerticalAlignment="Center"
                    Visibility="Collapsed">
                    <Ellipse
                        Width="8"
                        Height="8"
                        VerticalAlignment="Center"
                        Fill="{ThemeResource GlassSuccessBrush}" />
                    <TextBlock
                        x:Name="GameDetectedText"
                        FontSize="12"
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource GlassSuccessBrush}" />
                </StackPanel>

                <StackPanel
                    x:Name="GameNotDetectedGroup"
                    Orientation="Horizontal"
                    Spacing="8"
                    VerticalAlignment="Center">
                    <Ellipse
                        Width="8"
                        Height="8"
                        VerticalAlignment="Center"
                        Fill="{ThemeResource GlassMutedTextBrush}" />
                    <TextBlock
                        x:Name="GameNotDetectedText"
                        FontSize="12"
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource GlassMutedTextBrush}" />
                </StackPanel>

                <!-- Writes the combo to the character (the editor only): it asks which parts, then opens the review. -->
                <Button
                    x:Name="ApplyBarButton"
                    x:Uid="Preview/ApplyButton"
                    Grid.Column="1"
                    Visibility="Collapsed"
                    IsEnabled="{x:Bind Apply.CanRun, Mode=OneWay}"
                    Style="{StaticResource AccentButtonStyle}"
                    Click="ApplyBarButton_Click" />
            </Grid>
        </Border>
    </Grid>
</Window>
