<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="BdoComboSetup.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:BdoComboSetup"
    xmlns:conv="using:BdoComboSetup.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!--
                Glass palette (the "C · Shell cristal" design). The theme is chosen at run time by ThemeService: it sets
                RequestedTheme on the window root, so Light or Dark is picked from these dictionaries (Default follows Windows).
                Surfaces are translucent over the window backdrop. The accent brushes (AccentFillColorDefaultBrush,
                AccentTextFillColorPrimaryBrush, TextOnAccentFillColorPrimaryBrush, AccentGradientBrush, AccentButton*,
                GlassGlow* accent stops) are rewritten in place by ThemeService when the accent color changes; the values
                below are only the defaults (violet).
            -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <!-- Surfaces and lines -->
                    <SolidColorBrush x:Key="ApplicationPageBackgroundThemeBrush" Color="#00000000" />
                    <SolidColorBrush x:Key="SolidBackgroundFillColorBaseBrush" Color="#FFF5F4FA" />
                    <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#B8FFFFFF" />
                    <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#17141325" />
                    <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="#80FFFFFF" />
                    <SolidColorBrush x:Key="GlassLineBrush" Color="#17141325" />
                    <SolidColorBrush x:Key="GlassChipBrush" Color="#0F141325" />
                    <SolidColorBrush x:Key="GlassSelectedFillBrush" Color="#D9FFFFFF" />
                    <SolidColorBrush x:Key="GlassNavSelectedBrush" Color="#FFFFFFFF" />
                    <SolidColorBrush x:Key="GlassWindowTintBrush" Color="#8CFFFFFF" />
                    <SolidColorBrush x:Key="GlassWindowBorderBrush" Color="#BFFFFFFF" />
                    <SolidColorBrush x:Key="GlassStatusBarBrush" Color="#80FFFFFF" />
                    <SolidColorBrush x:Key="PreviewSurfaceBrush" Color="#FF0C1118" />

                    <!-- Text -->
                    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#FF141325" />
                    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#FF3B3A52" />
                    <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="#FF6F6D86" />
                    <SolidColorBrush x:Key="GlassMutedTextBrush" Color="#FF6F6D86" />
                    <SolidColorBrush x:Key="GlassSuccessBrush" Color="#FF11795F" />

                    <!-- Buttons (the secondary ones are glass; the accent one is AccentButtonBackground) -->
                    <SolidColorBrush x:Key="ButtonBackground" Color="#B8FFFFFF" />
                    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#D9FFFFFF" />
                    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#D9FFFFFF" />
                    <SolidColorBrush x:Key="ButtonBorderBrush" Color="#17141325" />
                    <SolidColorBrush x:Key="ButtonForeground" Color="#FF141325" />

                    <!-- Navigation: transparent panes, glass item states, accent-free selection (the accent is the glyph) -->
                    <SolidColorBrush x:Key="NavigationViewItemBackground" Color="#00000000" />
                    <SolidColorBrush x:Key="NavigationViewItemBackgroundPointerOver" Color="#D9FFFFFF" />
                    <SolidColorBrush x:Key="NavigationViewItemBackgroundPressed" Color="#D9FFFFFF" />
                    <SolidColorBrush x:Key="NavigationViewItemBackgroundSelected" Color="#FFFFFFFF" />
                    <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedPointerOver" Color="#FFFFFFFF" />
                    <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedPressed" Color="#FFFFFFFF" />
                    <SolidColorBrush x:Key="NavigationViewItemForeground" Color="#FF3B3A52" />
                    <SolidColorBrush x:Key="NavigationViewItemForegroundPointerOver" Color="#FF141325" />
                    <SolidColorBrush x:Key="NavigationViewItemForegroundPressed" Color="#FF141325" />
                    <SolidColorBrush x:Key="NavigationViewItemForegroundSelected" Color="#FF141325" />
                    <SolidColorBrush x:Key="NavigationViewItemForegroundSelectedPointerOver" Color="#FF141325" />
                    <SolidColorBrush x:Key="NavigationViewItemForegroundSelectedPressed" Color="#FF141325" />
                    <SolidColorBrush x:Key="NavigationViewItemHeaderForeground" Color="#FF6F6D86" />
                    <SolidColorBrush x:Key="NavigationViewSelectionIndicatorForeground" Color="#00000000" />
                    <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="#00000000" />
                    <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="#00000000" />
                    <SolidColorBrush x:Key="NavigationViewTopPaneBackground" Color="#00000000" />
                    <SolidColorBrush x:Key="NavigationViewContentBackground" Color="#00000000" />
                    <SolidColorBrush x:Key="NavigationViewButtonBackground" Color="#00000000" />
                    <SolidColorBrush x:Key="NavigationViewButtonBackgroundPointerOver" Color="#D9FFFFFF" />
                    <SolidColorBrush x:Key="NavigationViewButtonBackgroundPressed" Color="#D9FFFFFF" />
                    <SolidColorBrush x:Key="NavigationViewButtonForeground" Color="#FF3B3A52" />
                    <SolidColorBrush x:Key="NavigationViewButtonForegroundPointerOver" Color="#FF141325" />

                    <!-- Accent (violet by default): rewritten in place by ThemeService -->
                    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#FF6F5CFF" />
                    <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#FF6F5CFF" />
                    <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#FFFFFFFF" />
                    <SolidColorBrush x:Key="AccentButtonForeground" Color="#FFFFFFFF" />
                    <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="#FFFFFFFF" />
                    <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="#FFFFFFFF" />
                    <SolidColorBrush x:Key="AccentButtonBorderBrush" Color="#00000000" />
                    <SolidColorBrush x:Key="AccentButtonBorderBrushPointerOver" Color="#00000000" />
                    <SolidColorBrush x:Key="AccentButtonBorderBrushPressed" Color="#00000000" />
                    <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#FF8F80FF" Offset="0" />
                        <GradientStop Color="#FF6F5CFF" Offset="1" />
                    </LinearGradientBrush>
                    <LinearGradientBrush x:Key="AccentButtonBackground" StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#FF8F80FF" Offset="0" />
                        <GradientStop Color="#FF6F5CFF" Offset="1" />
                    </LinearGradientBrush>
                    <LinearGradientBrush x:Key="AccentButtonBackgroundPointerOver" StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#FF9D90FF" Offset="0" />
                        <GradientStop Color="#FF7B69FF" Offset="1" />
                    </LinearGradientBrush>
                    <LinearGradientBrush x:Key="AccentButtonBackgroundPressed" StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#FF6F5CFF" Offset="0" />
                        <GradientStop Color="#FF6251E0" Offset="1" />
                    </LinearGradientBrush>

                    <!-- Window backdrop: the gradient behind everything (base + accent, mint and rose glows) -->
                    <LinearGradientBrush x:Key="GlassBackdropBrush" StartPoint="0.55,0" EndPoint="0.45,1">
                        <GradientStop Color="#E6F7F5FF" Offset="0" />
                        <GradientStop Color="#E6F4F8FB" Offset="0.46" />
                        <GradientStop Color="#E6FDF7F6" Offset="1" />
                    </LinearGradientBrush>
                    <RadialGradientBrush x:Key="GlassGlowAccentBrush" Center="0.08,-0.06" GradientOrigin="0.08,-0.06" RadiusX="0.3875" RadiusY="0.358">
                        <GradientStop Color="#4D6F5CFF" Offset="0" />
                        <GradientStop Color="#006F5CFF" Offset="1" />
                    </RadialGradientBrush>
                    <RadialGradientBrush x:Key="GlassGlowMintBrush" Center="0.92,0.04" GradientOrigin="0.92,0.04" RadiusX="0.342" RadiusY="0.347">
                        <GradientStop Color="#3825C9A3" Offset="0" />
                        <GradientStop Color="#0025C9A3" Offset="1" />
                    </RadialGradientBrush>
                    <RadialGradientBrush x:Key="GlassGlowRoseBrush" Center="0.5,1.08" GradientOrigin="0.5,1.08" RadiusX="0.327" RadiusY="0.427">
                        <GradientStop Color="#2EFF6B9A" Offset="0" />
                        <GradientStop Color="#00FF6B9A" Offset="1" />
                    </RadialGradientBrush>
                </ResourceDictionary>

                <ResourceDictionary x:Key="Dark">
                    <!-- Surfaces and lines -->
                    <SolidColorBrush x:Key="ApplicationPageBackgroundThemeBrush" Color="#00000000" />
                    <SolidColorBrush x:Key="SolidBackgroundFillColorBaseBrush" Color="#FF14131F" />
                    <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#12FFFFFF" />
                    <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#17FFFFFF" />
                    <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="#0AFFFFFF" />
                    <SolidColorBrush x:Key="GlassLineBrush" Color="#17FFFFFF" />
                    <SolidColorBrush x:Key="GlassChipBrush" Color="#14FFFFFF" />
                    <SolidColorBrush x:Key="GlassSelectedFillBrush" Color="#1AFFFFFF" />
                    <SolidColorBrush x:Key="GlassNavSelectedBrush" Color="#1FFFFFFF" />
                    <SolidColorBrush x:Key="GlassWindowTintBrush" Color="#9918162C" />
                    <SolidColorBrush x:Key="GlassWindowBorderBrush" Color="#1AFFFFFF" />
                    <SolidColorBrush x:Key="GlassStatusBarBrush" Color="#0AFFFFFF" />
                    <SolidColorBrush x:Key="PreviewSurfaceBrush" Color="#FF0C1118" />

                    <!-- Text -->
                    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#FFF1F0FB" />
                    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#FFCFCDE6" />
                    <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="#FF9A98B4" />
                    <SolidColorBrush x:Key="GlassMutedTextBrush" Color="#FF9A98B4" />
                    <SolidColorBrush x:Key="GlassSuccessBrush" Color="#FF46DCB8" />

                    <!-- Buttons (the secondary ones are glass; the accent one is AccentButtonBackground) -->
                    <SolidColorBrush x:Key="ButtonBackground" Color="#12FFFFFF" />
                    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#1AFFFFFF" />
                    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#1AFFFFFF" />
                    <SolidColorBrush x:Key="ButtonBorderBrush" Color="#17FFFFFF" />
                    <SolidColorBrush x:Key="ButtonForeground" Color="#FFF1F0FB" />

                    <!-- Navigation: transparent panes, glass item states, accent-free selection (the accent is the glyph) -->
                    <SolidColorBrush x:Key="NavigationViewItemBackground" Color="#00000000" />
                    <SolidColorBrush x:Key="NavigationViewItemBackgroundPointerOver" Color="#1AFFFFFF" />
                    <SolidColorBrush x:Key="NavigationViewItemBackgroundPressed" Color="#1AFFFFFF" />
                    <SolidColorBrush x:Key="NavigationViewItemBackgroundSelected" Color="#1FFFFFFF" />
                    <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedPointerOver" Color="#1FFFFFFF" />
                    <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedPressed" Color="#1FFFFFFF" />
                    <SolidColorBrush x:Key="NavigationViewItemForeground" Color="#FFCFCDE6" />
                    <SolidColorBrush x:Key="NavigationViewItemForegroundPointerOver" Color="#FFF1F0FB" />
                    <SolidColorBrush x:Key="NavigationViewItemForegroundPressed" Color="#FFF1F0FB" />
                    <SolidColorBrush x:Key="NavigationViewItemForegroundSelected" Color="#FFF1F0FB" />
                    <SolidColorBrush x:Key="NavigationViewItemForegroundSelectedPointerOver" Color="#FFF1F0FB" />
                    <SolidColorBrush x:Key="NavigationViewItemForegroundSelectedPressed" Color="#FFF1F0FB" />
                    <SolidColorBrush x:Key="NavigationViewItemHeaderForeground" Color="#FF9A98B4" />
                    <SolidColorBrush x:Key="NavigationViewSelectionIndicatorForeground" Color="#00000000" />
                    <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="#00000000" />
                    <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="#00000000" />
                    <SolidColorBrush x:Key="NavigationViewTopPaneBackground" Color="#00000000" />
                    <SolidColorBrush x:Key="NavigationViewContentBackground" Color="#00000000" />
                    <SolidColorBrush x:Key="NavigationViewButtonBackground" Color="#00000000" />
                    <SolidColorBrush x:Key="NavigationViewButtonBackgroundPointerOver" Color="#1AFFFFFF" />
                    <SolidColorBrush x:Key="NavigationViewButtonBackgroundPressed" Color="#1AFFFFFF" />
                    <SolidColorBrush x:Key="NavigationViewButtonForeground" Color="#FFCFCDE6" />
                    <SolidColorBrush x:Key="NavigationViewButtonForegroundPointerOver" Color="#FFF1F0FB" />

                    <!-- Accent (violet by default): rewritten in place by ThemeService -->
                    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#FF9A8CFF" />
                    <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#FF9A8CFF" />
                    <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#FF160F06" />
                    <SolidColorBrush x:Key="AccentButtonForeground" Color="#FF160F06" />
                    <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="#FF160F06" />
                    <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="#FF160F06" />
                    <SolidColorBrush x:Key="AccentButtonBorderBrush" Color="#00000000" />
                    <SolidColorBrush x:Key="AccentButtonBorderBrushPointerOver" Color="#00000000" />
                    <SolidColorBrush x:Key="AccentButtonBorderBrushPressed" Color="#00000000" />
                    <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#FFB0A5FF" Offset="0" />
                        <GradientStop Color="#FF9A8CFF" Offset="1" />
                    </LinearGradientBrush>
                    <LinearGradientBrush x:Key="AccentButtonBackground" StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#FFB0A5FF" Offset="0" />
                        <GradientStop Color="#FF9A8CFF" Offset="1" />
                    </LinearGradientBrush>
                    <LinearGradientBrush x:Key="AccentButtonBackgroundPointerOver" StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#FFBAB1FF" Offset="0" />
                        <GradientStop Color="#FFA295FF" Offset="1" />
                    </LinearGradientBrush>
                    <LinearGradientBrush x:Key="AccentButtonBackgroundPressed" StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#FF9A8CFF" Offset="0" />
                        <GradientStop Color="#FF887BE0" Offset="1" />
                    </LinearGradientBrush>

                    <!-- Window backdrop: the gradient behind everything (base + accent, mint and rose glows) -->
                    <LinearGradientBrush x:Key="GlassBackdropBrush" StartPoint="0.55,0" EndPoint="0.45,1">
                        <GradientStop Color="#E60E0D1C" Offset="0" />
                        <GradientStop Color="#E60A0F18" Offset="0.46" />
                        <GradientStop Color="#E6150D14" Offset="1" />
                    </LinearGradientBrush>
                    <RadialGradientBrush x:Key="GlassGlowAccentBrush" Center="0.08,-0.06" GradientOrigin="0.08,-0.06" RadiusX="0.3875" RadiusY="0.358">
                        <GradientStop Color="#429A8CFF" Offset="0" />
                        <GradientStop Color="#009A8CFF" Offset="1" />
                    </RadialGradientBrush>
                    <RadialGradientBrush x:Key="GlassGlowMintBrush" Center="0.92,0.04" GradientOrigin="0.92,0.04" RadiusX="0.342" RadiusY="0.347">
                        <GradientStop Color="#2425C9A3" Offset="0" />
                        <GradientStop Color="#0025C9A3" Offset="1" />
                    </RadialGradientBrush>
                    <RadialGradientBrush x:Key="GlassGlowRoseBrush" Center="0.5,1.08" GradientOrigin="0.5,1.08" RadiusX="0.327" RadiusY="0.427">
                        <GradientStop Color="#1FFF6B9A" Offset="0" />
                        <GradientStop Color="#00FF6B9A" Offset="1" />
                    </RadialGradientBrush>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <local:BoolToVisibilityConverter x:Key="BoolToVisibility" />
            <conv:OffsetToMarginConverter x:Key="OffsetToMargin" />

            <!-- Rounder controls for the glass look (fields, combo boxes, buttons). -->
            <CornerRadius x:Key="ControlCornerRadius">14</CornerRadius>

            <!-- Glass card: the summary, the detail panel and the preview bars. -->
            <Style x:Key="GlassCardStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource GlassLineBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="18" />
                <Setter Property="Padding" Value="16" />
            </Style>
            <Style x:Key="CardBorderStyle" TargetType="Border" BasedOn="{StaticResource GlassCardStyle}" />

            <!-- Dark panel behind the preview surface (the game screen is always dark). -->
            <Style x:Key="PreviewSurfaceStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource PreviewSurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource GlassLineBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="18" />
                <Setter Property="Padding" Value="16" />
            </Style>

            <!-- Apply page: a step card, selected (accent outline) or not. -->
            <Style x:Key="StepCardStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource ControlFillColorSecondaryBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource GlassLineBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="18" />
            </Style>
            <Style x:Key="StepCardSelectedStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource ControlFillColorSecondaryBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource AccentFillColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="18" />
            </Style>

            <!-- Apply page: a spec pill (Awakening, Succession, ...). Fully round. -->
            <Style x:Key="PillStyle" TargetType="Button">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource GlassLineBrush}" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="CornerRadius" Value="99" />
                <Setter Property="Padding" Value="14,6" />
            </Style>
            <Style x:Key="PillSelectedStyle" TargetType="Button">
                <Setter Property="Background" Value="{ThemeResource AccentGradientBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource AccentFillColorDefaultBrush}" />
                <Setter Property="Foreground" Value="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                <Setter Property="CornerRadius" Value="99" />
                <Setter Property="Padding" Value="14,6" />
            </Style>

            <!-- Apply page: a class tile in the class grid. -->
            <Style x:Key="ClassTileStyle" TargetType="Button">
                <Setter Property="Background" Value="{ThemeResource ControlFillColorSecondaryBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource GlassLineBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="12" />
            </Style>
            <Style x:Key="ClassTileSelectedStyle" TargetType="Button">
                <Setter Property="Background" Value="{ThemeResource ControlFillColorSecondaryBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource AccentFillColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="2" />
                <Setter Property="CornerRadius" Value="12" />
            </Style>

            <!-- Navigation items (glass shell): the pill height of a left-pane item. -->
            <x:Double x:Key="NavigationViewItemOnLeftMinHeight">46</x:Double>

        </ResourceDictionary>
    </Application.Resources>
</Application>
