<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="BdoComboSetup.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:BdoComboSetup"
    xmlns:conv="using:BdoComboSetup.Converters"
    RequestedTheme="Dark">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Palette of the approved design, applied by overriding the theme tokens (the controls keep their own templates).
                 window #101216, nav #14171c, page #171a20, cards #1b1e25, border #2b303a, text #e8e6e1, muted #a3a8b3, gold #d2b06a. -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="ApplicationPageBackgroundThemeBrush" Color="#FF171A20" />
                    <SolidColorBrush x:Key="SolidBackgroundFillColorBaseBrush" Color="#FF14171C" />
                    <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#FF1B1E25" />
                    <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#FF2B303A" />
                    <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="#FF232731" />
                    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#FFE8E6E1" />
                    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#FFA3A8B3" />
                    <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="#FF8A909C" />
                    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#FFD2B06A" />
                    <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#FFD2B06A" />
                    <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#FF171A20" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <local:BoolToVisibilityConverter x:Key="BoolToVisibility" />
            <conv:OffsetToMarginConverter x:Key="OffsetToMargin" />
            <conv:FilePathToImageConverter x:Key="FilePathToImage" />

            <!-- Card surface shared by the summary, the detail panel and the preview bars. -->
            <Style x:Key="CardBorderStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="{ThemeResource OverlayCornerRadius}" />
                <Setter Property="Padding" Value="16" />
            </Style>

            <!-- Dark panel behind the preview surface. -->
            <Style x:Key="PreviewSurfaceStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource SolidBackgroundFillColorBaseBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="{ThemeResource OverlayCornerRadius}" />
                <Setter Property="Padding" Value="16" />
            </Style>

            <!-- Apply page: a step card, selected (gold outline) or not. -->
            <Style x:Key="StepCardStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource ControlFillColorSecondaryBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
            </Style>
            <Style x:Key="StepCardSelectedStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource ControlFillColorSecondaryBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource AccentFillColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
            </Style>

            <!-- Apply page: a spec pill (Awakening, Succession, ...). -->
            <Style x:Key="PillStyle" TargetType="Button">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="CornerRadius" Value="16" />
                <Setter Property="Padding" Value="14,6" />
            </Style>
            <Style x:Key="PillSelectedStyle" TargetType="Button">
                <Setter Property="Background" Value="{ThemeResource AccentFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource AccentFillColorDefaultBrush}" />
                <Setter Property="Foreground" Value="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                <Setter Property="CornerRadius" Value="16" />
                <Setter Property="Padding" Value="14,6" />
            </Style>

            <!-- Apply page: a class tile in the class grid. -->
            <Style x:Key="ClassTileStyle" TargetType="Button">
                <Setter Property="Background" Value="{ThemeResource ControlFillColorSecondaryBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
            </Style>
            <Style x:Key="ClassTileSelectedStyle" TargetType="Button">
                <Setter Property="Background" Value="{ThemeResource ControlFillColorSecondaryBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource AccentFillColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="2" />
                <Setter Property="CornerRadius" Value="8" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
