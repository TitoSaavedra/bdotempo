<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <RootNamespace>BdoComboSetup</RootNamespace>
    <AssemblyName>BdoComboSetup</AssemblyName>
    <Version>0.1.0</Version>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- LibraryImport (source-generated P/Invoke) for the window locator and the capture. Only the marshalling is generated. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <UseWinUI>true</UseWinUI>
    <DefaultLanguage>en-US</DefaultLanguage>
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!-- Unpackaged: no MSIX identity, no installer. The tooling flag is required by the single-file targets
         so that resources.pri (the .resw strings) is embedded in the exe. -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <EnableMsixTooling>true</EnableMsixTooling>
    <!-- Program.cs provides Main, so the runtime base directory can be set before WinRT activation. -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>

    <!-- Only the languages the app ships: keeps the runtime satellite assemblies out of the exe. -->
    <SatelliteResourceLanguages>en;es</SatelliteResourceLanguages>

    <Platforms>x64</Platforms>
    <Platform Condition="'$(Platform)' == ''">x64</Platform>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>

    <!-- ONE self-contained single-file exe: no .NET and no Windows App SDK needed on the machine. -->
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <!-- Symbols embedded in the assemblies, so the publish folder holds only the exe. -->
    <DebugType>embedded</DebugType>
    <PublishReadyToRun>false</PublishReadyToRun>
    <PublishTrimmed>false</PublishTrimmed>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.6.4" />
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
    <PackageReference Include="Vortice.DXGI" Version="3.8.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BdoComboSetup.Core\BdoComboSetup.Core.csproj" />
  </ItemGroup>

  <!-- The asset bundle from `mise run build-assets` (git-ignored, copyrighted game art): every file is embedded in the
       exe under its own file name (catalog.json, skill-<no>.png, ...), so the single-file exe needs no loose files.
       With no bundle folder the wildcard matches nothing and the app falls back to the file catalogs and glyphs. -->
  <ItemGroup>
    <EmbeddedResource Include="Assets\generated\*" LogicalName="%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
