<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <RootNamespace>BdoComboSetup</RootNamespace>
    <AssemblyName>BDOTempo</AssemblyName>
    <Product>BDOTempo</Product>
    <Title>BDOTempo</Title>
    <!-- Version: app/Directory.Build.props (single source of truth). -->

    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- LibraryImport (source-generated P/Invoke) for the window locator and the capture. Only the marshalling is generated. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <UseWinUI>true</UseWinUI>
    <DefaultLanguage>en-US</DefaultLanguage>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- The exe icon (Explorer, taskbar). Original art, see app/assets/icon/ (rebuild with mise run build-icon). -->
    <ApplicationIcon>..\..\assets\icon\app-icon.ico</ApplicationIcon>

    <!-- Unpackaged: no MSIX identity. The tooling flag makes resources.pri (the .resw strings) part of the build output. -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <EnableMsixTooling>true</EnableMsixTooling>
    <!-- Program.cs provides Main, so the runtime base directory can be set before WinRT activation. -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>

    <!-- Only the languages the app ships: keeps the runtime satellite assemblies out of the exe. -->
    <SatelliteResourceLanguages>en;es</SatelliteResourceLanguages>

    <Platforms>x64</Platforms>
    <Platform Condition="'$(Platform)' == ''">x64</Platform>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>

    <!-- Framework-dependent: the machine needs the .NET 10 Desktop Runtime (checked by the installer). The Windows App SDK
         runtime is bundled (WindowsAppSDKSelfContained), so it is never needed on the machine. -->
    <SelfContained>false</SelfContained>
    <!-- Symbols embedded in the assemblies, so the publish folder holds only the exe and its runtime files. -->
    <DebugType>embedded</DebugType>
    <PublishReadyToRun>false</PublishReadyToRun>
    <PublishTrimmed>false</PublishTrimmed>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.6.4" />
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
    <PackageReference Include="Vortice.DXGI" Version="3.8.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BdoComboSetup.Core\BdoComboSetup.Core.csproj" />
  </ItemGroup>

  <!-- The window icon (AppWindow.SetIcon and the title bar) is embedded: the single-file exe has no loose files next to it.
       WindowIcon.cs writes these copies to %LOCALAPPDATA%\BDOTempo\icon at run time, because SetIcon takes a path. -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\assets\icon\app-icon.ico" LogicalName="BdoComboSetup.app-icon.ico" />
    <EmbeddedResource Include="..\..\assets\icon\app-icon-256.png" LogicalName="BdoComboSetup.app-icon-256.png" />
  </ItemGroup>

  <!-- The app does not embed the game art. It opens assets.bdoa from the folder next to the exe at run time;
       the installer (or the portable zip) puts the assembled file there. See app/docs/asset-pack-format.md. -->

</Project>
