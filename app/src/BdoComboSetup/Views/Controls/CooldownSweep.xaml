<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="BdoComboSetup.Views.Controls.CooldownSweep"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Radial cooldown sweep over a 42 x 42 icon area, approximated: the remaining part is darkened clockwise from 12 o'clock. -->
    <Grid>
        <Path x:Name="SweepPath" Fill="#A6000000" />
        <TextBlock
            x:Name="NumberText"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            FontSize="15"
            FontWeight="SemiBold"
            Foreground="#FFF5EAD0" />
    </Grid>
</UserControl>
