<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="BdoComboSetup.Views.GameScreenCanvas"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:core="using:BdoComboSetup.Core.ViewModels"
    >

    <UserControl.Resources>
        <!-- Colours are BDO-like: dark slots, warm gold borders, tints per cooldown group. Sizes are game pixels. -->
        <SolidColorBrush x:Key="SlotFillBrush" Color="#E6120F0C" />
        <SolidColorBrush x:Key="SlotBorderBrush" Color="#FF9C8A5E" />
        <SolidColorBrush x:Key="SlotDimBorderBrush" Color="#FF8A7C5A" />
        <SolidColorBrush x:Key="ComboTintBrush" Color="#33C9A24A" />
        <SolidColorBrush x:Key="BuffTintBrush" Color="#333FA7A0" />
        <SolidColorBrush x:Key="SelectedBrush" Color="#FFF3D27A" />
        <SolidColorBrush x:Key="TextBrush" Color="#FFF5EAD0" />
        <SolidColorBrush x:Key="PanelOutlineBrush" Color="#66FFFFFF" />
        <SolidColorBrush x:Key="CandidateOutlineBrush" Color="#FFFFC857" />
        <LinearGradientBrush x:Key="FallbackScreenBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FF1F1D2A" Offset="0" />
            <GradientStop Color="#FF0B0A10" Offset="1" />
        </LinearGradientBrush>

        <ItemsPanelTemplate x:Key="StackingGridPanel">
            <Grid />
        </ItemsPanelTemplate>

        <!-- One cooldown slot. Offset and size come from the view model (game pixels, relative to the bar). -->
        <DataTemplate x:Key="SlotTemplate" x:DataType="core:SlotViewModel">
            <Grid
                Width="{x:Bind Size, Mode=OneWay}"
                Height="{x:Bind Size, Mode=OneWay}"
                Margin="{x:Bind Offset, Mode=OneWay, Converter={StaticResource OffsetToMargin}}"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Visibility="{x:Bind IsPlaced, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                Tag="{x:Bind}">
                <!-- Empty slot: dim outline only. -->
                <Border
                    CornerRadius="3"
                    Background="{StaticResource SlotFillBrush}"
                    BorderBrush="{StaticResource SlotDimBorderBrush}"
                    BorderThickness="1"
                    Opacity="0.7"
                    Visibility="{x:Bind IsEmpty, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />

                <!-- Filled slot: icon (or glyph), cooldown group tint, gold border. -->
                <Border
                    CornerRadius="3"
                    Background="{StaticResource SlotFillBrush}"
                    BorderBrush="{StaticResource SlotBorderBrush}"
                    BorderThickness="1"
                    Visibility="{x:Bind IsEmpty, Mode=OneWay, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}">
                    <Grid>
                        <Image
                            Source="{x:Bind IconPath, Mode=OneWay, Converter={StaticResource FilePathToImage}}"
                            Stretch="UniformToFill"
                            Visibility="{x:Bind HasIcon, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock
                            Text="{x:Bind Glyph, Mode=OneWay}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="22"
                            Foreground="{StaticResource TextBrush}"
                            Visibility="{x:Bind HasIcon, Mode=OneWay, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}" />
                        <Border
                            Background="{StaticResource ComboTintBrush}"
                            Visibility="{x:Bind IsComboSkill, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                        <Border
                            Background="{StaticResource BuffTintBrush}"
                            Visibility="{x:Bind IsPriorityBuff, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                    </Grid>
                </Border>

                <Border
                    CornerRadius="3"
                    BorderBrush="{StaticResource SelectedBrush}"
                    BorderThickness="2"
                    Visibility="{x:Bind IsSelected, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />

                <!-- The memo (the key that fires the skill) sits bottom-right, as in the game. -->
                <TextBlock
                    Text="{x:Bind Memo, Mode=OneWay}"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Margin="0,0,3,1"
                    FontSize="15"
                    Foreground="{StaticResource TextBrush}" />
            </Grid>
        </DataTemplate>

        <!-- One quick slot: the skill of that position (icon or glyph) and the input label bottom-right. -->
        <DataTemplate x:Key="QuickSlotTemplate" x:DataType="core:QuickSlotViewModel">
            <Grid
                Width="{x:Bind Size, Mode=OneWay}"
                Height="{x:Bind Size, Mode=OneWay}"
                Margin="{x:Bind Offset, Mode=OneWay, Converter={StaticResource OffsetToMargin}}"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Tag="{x:Bind}">
                <!-- Position without a skill: dim outline only. -->
                <Border
                    CornerRadius="3"
                    Background="{StaticResource SlotFillBrush}"
                    BorderBrush="{StaticResource SlotDimBorderBrush}"
                    BorderThickness="1"
                    Opacity="0.7"
                    Visibility="{x:Bind HasSlot, Mode=OneWay, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}" />
                <Border
                    CornerRadius="3"
                    Background="{StaticResource SlotFillBrush}"
                    BorderBrush="{StaticResource SlotBorderBrush}"
                    BorderThickness="1"
                    Visibility="{x:Bind HasSlot, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                <Grid Visibility="{x:Bind HasSlot, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                    <Image
                        Source="{x:Bind Slot.IconPath, Mode=OneWay, Converter={StaticResource FilePathToImage}}"
                        Stretch="UniformToFill" />
                    <TextBlock
                        Text="{x:Bind Slot.Glyph, Mode=OneWay}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="22"
                        Foreground="{StaticResource TextBrush}" />
                </Grid>
                <TextBlock
                    Text="{x:Bind Label, Mode=OneWay}"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Margin="0,0,3,1"
                    FontSize="15"
                    Foreground="{StaticResource TextBrush}" />
            </Grid>
        </DataTemplate>

        <!-- Debug overlay: one faint outline per visible UIData panel, with its index. Candidates are gold. -->
        <DataTemplate x:Key="UiPanelTemplate" x:DataType="core:UiPanelOverlayViewModel">
            <Grid
                Width="{x:Bind Width, Mode=OneTime}"
                Height="{x:Bind Height, Mode=OneTime}"
                Margin="{x:Bind Offset, Mode=OneTime, Converter={StaticResource OffsetToMargin}}"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                IsHitTestVisible="False">
                <Border
                    BorderBrush="{StaticResource PanelOutlineBrush}"
                    BorderThickness="1"
                    Background="#0AFFFFFF"
                    Visibility="{x:Bind IsCandidate, Mode=OneTime, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}">
                    <TextBlock Text="{x:Bind Label, Mode=OneTime}" FontSize="15" Foreground="{StaticResource PanelOutlineBrush}" Margin="2,0,0,0" />
                </Border>
                <Border
                    BorderBrush="{StaticResource CandidateOutlineBrush}"
                    BorderThickness="2"
                    Background="#18FFC857"
                    Visibility="{x:Bind IsCandidate, Mode=OneTime, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{x:Bind Label, Mode=OneTime}" FontSize="15" Foreground="{StaticResource CandidateOutlineBrush}" Margin="2,0,0,0" />
                </Border>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <!-- Dark panel behind the game screen. The Viewbox scales the game-pixel screen to the space available. -->
    <Border Style="{StaticResource PreviewSurfaceStyle}">
        <Viewbox Stretch="Uniform">
            <Grid
                x:Name="ScreenGrid"
                Width="{Binding GameWidth, Mode=OneTime}"
                Height="{Binding GameHeight, Mode=OneTime}"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Background="{StaticResource FallbackScreenBrush}">

                <!-- The real screenshot, stretched to the game size (same aspect ratio). Without it the gradient shows. -->
                <Image
                    Source="{Binding BackgroundPath, Converter={StaticResource FilePathToImage}}"
                    Stretch="Fill" />

                <ItemsControl
                    ItemsSource="{Binding UiPanels}"
                    ItemTemplate="{StaticResource UiPanelTemplate}"
                    ItemsPanel="{StaticResource StackingGridPanel}"
                    IsHitTestVisible="False"
                    Visibility="{Binding ShowUiPanels, Converter={StaticResource BoolToVisibility}}" />

                <!-- Cooldown bar: caption above, slots inside. Dragged when its position is not verified. -->
                <Grid
                    x:Name="CooldownBarGrid"
                    Width="{Binding CooldownBar.Width}"
                    Height="{Binding CooldownBar.Height}"
                    Margin="{Binding CooldownBar.Offset, Converter={StaticResource OffsetToMargin}}"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Background="Transparent"
                    PointerPressed="Bar_PointerPressed"
                    PointerMoved="Bar_PointerMoved"
                    PointerReleased="Bar_PointerReleased"
                    PointerCaptureLost="Bar_PointerCaptureLost">
                    <TextBlock
                        Text="{Binding CooldownBar.Title}"
                        Margin="0,-24,0,0"
                        VerticalAlignment="Top"
                        FontSize="24"
                        Foreground="{StaticResource TextBrush}"
                        IsHitTestVisible="False" />
                    <ItemsControl
                        ItemsSource="{Binding CooldownSlots}"
                        ItemTemplate="{StaticResource SlotTemplate}"
                        ItemsPanel="{StaticResource StackingGridPanel}"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch" />
                </Grid>

                <!-- Quick bar: the nine positions in a row. -->
                <Grid
                    x:Name="QuickBarGrid"
                    Width="{Binding QuickBar.Width}"
                    Height="{Binding QuickBar.Height}"
                    Margin="{Binding QuickBar.Offset, Converter={StaticResource OffsetToMargin}}"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Background="Transparent"
                    PointerPressed="Bar_PointerPressed"
                    PointerMoved="Bar_PointerMoved"
                    PointerReleased="Bar_PointerReleased"
                    PointerCaptureLost="Bar_PointerCaptureLost">
                    <TextBlock
                        Text="{Binding QuickBar.Title}"
                        Margin="0,-24,0,0"
                        VerticalAlignment="Top"
                        FontSize="24"
                        Foreground="{StaticResource TextBrush}"
                        IsHitTestVisible="False" />
                    <ItemsControl
                        ItemsSource="{Binding QuickSlots}"
                        ItemTemplate="{StaticResource QuickSlotTemplate}"
                        ItemsPanel="{StaticResource StackingGridPanel}"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch" />
                </Grid>
            </Grid>
        </Viewbox>
    </Border>
</UserControl>
