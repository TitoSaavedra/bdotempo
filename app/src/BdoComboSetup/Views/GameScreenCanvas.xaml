<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="BdoComboSetup.Views.GameScreenCanvas"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:core="using:BdoComboSetup.Core.ViewModels"
    xmlns:controls="using:BdoComboSetup.Views.Controls"
    >

    <UserControl.Resources>
        <!-- The key legend of a quick slot: #40D7FD for a skill, #626262 when empty (items are not in the combo, so no #88DF00). -->
        <SolidColorBrush x:Key="LegendSkillBrush" Color="#FF40D7FD" />
        <SolidColorBrush x:Key="LegendEmptyBrush" Color="#FF626262" />
        <SolidColorBrush x:Key="HiddenOutlineBrush" Color="#CCFFFFFF" />

        <!-- Every slot is a child of one grid, placed by its margin (game pixels, top-left corner of the panel). -->
        <ItemsPanelTemplate x:Key="OverlayPanel">
            <Grid />
        </ItemsPanelTemplate>

        <!-- Cooldown slot: 50 x 50, no frame, no background; the 42 x 42 icon at (4, 7); the sweep and the time at (3, 6) while cooling down.
             A click opens the skill picker of the slot (the class skills at their top rank). -->
        <DataTemplate x:Key="CooldownSlotTemplate" x:DataType="core:SlotViewModel">
            <Grid
                Width="50"
                Height="50"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Margin="{x:Bind Offset, Mode=OneWay, Converter={StaticResource OffsetToMargin}}"
                Opacity="{x:Bind Opacity, Mode=OneWay}"
                RenderTransformOrigin="0,0"
                Background="Transparent"
                Tapped="CooldownSlot_Tapped"
                Visibility="{x:Bind IsDrawn, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                <Grid.RenderTransform>
                    <ScaleTransform ScaleX="{x:Bind Scale, Mode=OneWay}" ScaleY="{x:Bind Scale, Mode=OneWay}" />
                </Grid.RenderTransform>
                <!-- An empty slot draws nothing in the game (the bar has no background art); the preview marks where it is,
                     with its slot number, so all 20 slots can be seen. -->
                <Rectangle
                    Width="50"
                    Height="50"
                    Stroke="#26FFFFFF"
                    StrokeThickness="1"
                    Visibility="{x:Bind HasSkill, Mode=OneWay, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}" />
                <TextBlock
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontFamily="Segoe UI Semibold"
                    FontSize="13"
                    Foreground="#59FFFFFF"
                    Text="{x:Bind Glyph, Mode=OneWay}"
                    Visibility="{x:Bind HasSkill, Mode=OneWay, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}" />
                <controls:AssetIcon
                    Width="42"
                    Height="42"
                    Margin="4,7,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Glyph="{x:Bind Glyph, Mode=OneWay}"
                    IconSource="{x:Bind Icon, Mode=OneWay}"
                    Visibility="{x:Bind HasSkill, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                <controls:CooldownSweep
                    Margin="3,6,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Label="{x:Bind CooldownText, Mode=OneWay}"
                    Ratio="{x:Bind CooldownRatio, Mode=OneWay}"
                    Visibility="{x:Bind IsCoolingDown, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                <Rectangle
                    Width="50"
                    Height="50"
                    Stroke="{StaticResource HiddenOutlineBrush}"
                    StrokeThickness="1"
                    StrokeDashArray="3 2"
                    Visibility="{x:Bind ShowsDashedOutline, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
            </Grid>
        </DataTemplate>

        <!-- Quick slot: 50 x 65, no frame. The game's semi-transparent background (44 x 44 at (3, 21)), the 42 x 42 icon at
             (4, 22), and the key legend centred on top with its text top at y = 10. The handle strip is only shown on hover in the game. -->
        <DataTemplate x:Key="QuickSlotTemplate" x:DataType="core:QuickSlotViewModel">
            <Grid
                Width="50"
                Height="65"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Margin="{x:Bind Offset, Mode=OneWay, Converter={StaticResource OffsetToMargin}}"
                Opacity="{x:Bind Opacity, Mode=OneWay}"
                RenderTransformOrigin="0,0"
                Visibility="{x:Bind IsDrawn, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                <Grid.RenderTransform>
                    <ScaleTransform ScaleX="{x:Bind Scale, Mode=OneWay}" ScaleY="{x:Bind Scale, Mode=OneWay}" />
                </Grid.RenderTransform>
                <controls:SlotArtImage
                    Width="44"
                    Height="44"
                    Margin="3,21,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Art="QuickSlotBackground" />
                <controls:AssetIcon
                    Width="42"
                    Height="42"
                    Margin="4,22,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Glyph="{x:Bind Glyph, Mode=OneWay}"
                    IconSource="{x:Bind Icon, Mode=OneWay}"
                    Visibility="{x:Bind HasSkill, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                <TextBlock
                    Width="50"
                    Height="20"
                    Margin="0,10,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    FontFamily="Segoe UI Semibold"
                    FontSize="14"
                    TextAlignment="Center"
                    Text="{x:Bind KeyLabel, Mode=OneWay}"
                    Foreground="{StaticResource LegendSkillBrush}"
                    Visibility="{x:Bind HasSkill, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                <TextBlock
                    Width="50"
                    Height="20"
                    Margin="0,10,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    FontFamily="Segoe UI Semibold"
                    FontSize="14"
                    TextAlignment="Center"
                    Text="{x:Bind KeyLabel, Mode=OneWay}"
                    Foreground="{StaticResource LegendEmptyBrush}"
                    Visibility="{x:Bind HasSkill, Mode=OneWay, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}" />
                <Rectangle
                    Width="50"
                    Height="65"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Stroke="{StaticResource HiddenOutlineBrush}"
                    StrokeThickness="1"
                    StrokeDashArray="3 2"
                    Visibility="{x:Bind ShowsDashedOutline, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
            </Grid>
        </DataTemplate>

        <!-- One row of the skill picker of a cooldown slot: the skill icon and its name. -->
        <DataTemplate x:Key="SkillPickTemplate" x:DataType="core:SkillOption">
            <Grid Padding="4,2" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <controls:AssetIcon
                    Width="28"
                    Height="28"
                    IconSource="{x:Bind Skill.OpenIcon, Mode=OneTime}" />
                <TextBlock
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Text="{x:Bind Name, Mode=OneTime}"
                    TextTrimming="CharacterEllipsis" />
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <!-- The game screen in game pixels, scaled as a whole (fit times zoom). The scroll viewer shows what is larger than the window. -->
    <Border Background="#FF000000">
        <ScrollViewer
            x:Name="Viewport"
            HorizontalScrollBarVisibility="Auto"
            VerticalScrollBarVisibility="Auto"
            HorizontalScrollMode="Auto"
            VerticalScrollMode="Auto"
            ZoomMode="Disabled"
            SizeChanged="Viewport_SizeChanged"
            PointerWheelChanged="Viewport_PointerWheelChanged">
            <Grid
                x:Name="ScreenHost"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
                <Grid
                    x:Name="ScreenGrid"
                    Width="{Binding GameWidth, Mode=OneTime}"
                    Height="{Binding GameHeight, Mode=OneTime}"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Background="#FF000000"
                    RenderTransformOrigin="0,0">
                    <Grid.RenderTransform>
                        <ScaleTransform x:Name="ScreenTransform" />
                    </Grid.RenderTransform>

                    <!-- The live capture of the game window, drawn to the game size. Black until a frame arrives. -->
                    <Image x:Name="LiveImage" Stretch="Fill" />

                    <ItemsControl
                        ItemsSource="{Binding CooldownSlots}"
                        ItemTemplate="{StaticResource CooldownSlotTemplate}"
                        ItemsPanel="{StaticResource OverlayPanel}" />

                    <ItemsControl
                        ItemsSource="{Binding QuickSlots}"
                        ItemTemplate="{StaticResource QuickSlotTemplate}"
                        ItemsPanel="{StaticResource OverlayPanel}" />
                </Grid>
            </Grid>
        </ScrollViewer>
    </Border>
</UserControl>
