<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="BdoComboSetup.Views.ApplyComboPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:BdoComboSetup.Views"
    xmlns:controls="using:BdoComboSetup.Views.Controls"
    xmlns:vm="using:BdoComboSetup.Core.ViewModels"
    xmlns:combo="using:BdoComboSetup.Core.Combo"
    xmlns:mux="using:Microsoft.UI.Xaml.Controls"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.Resources>
        <!-- Compact controls on this page: buttons and combo boxes are about 30 pixels high, with 13-pixel text. -->
        <Style TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style TargetType="ComboBox" BasedOn="{StaticResource DefaultComboBoxStyle}">
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="FontSize" Value="13" />
        </Style>

        <!-- One character of the account in the choice dialog: class icon and name only. Name and class are edited in Settings. -->
        <DataTemplate x:Key="CharacterTemplate" x:DataType="combo:CharacterOption">
            <Grid ColumnSpacing="10" Padding="4,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <controls:AssetIcon
                    Monochrome="True"
                    Width="28"
                    Height="28"
                    IconSource="{x:Bind local:ApplyComboPage.ClassIconOf(ClassType), Mode=OneTime}"
                    Glyph="{x:Bind local:ApplyComboPage.ClassGlyphOf(ClassType), Mode=OneTime}" />
                <TextBlock
                    Grid.Column="1"
                    Text="{x:Bind Name, Mode=OneTime}"
                    FontWeight="SemiBold"
                    VerticalAlignment="Center"
                    TextTrimming="CharacterEllipsis" />
            </Grid>
        </DataTemplate>

        <!-- The character that is selected, next to "Change". -->
        <DataTemplate x:Key="SelectedCharacterTemplate" x:DataType="combo:CharacterOption">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <controls:AssetIcon
                    Monochrome="True"
                    Width="24"
                    Height="24"
                    IconSource="{x:Bind local:ApplyComboPage.ClassIconOf(ClassType), Mode=OneTime}"
                    Glyph="{x:Bind local:ApplyComboPage.ClassGlyphOf(ClassType), Mode=OneTime}" />
                <TextBlock Text="{x:Bind Name, Mode=OneTime}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </DataTemplate>

        <!-- One class of the class list: its icon and its name. The selected class gets the glass highlight. -->
        <DataTemplate x:Key="ClassRowTemplate" x:DataType="vm:ClassOptionViewModel">
            <Grid Margin="0,1">
                <Border
                    CornerRadius="8"
                    BorderThickness="1"
                    Background="{ThemeResource GlassSelectedFillBrush}"
                    BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                    Visibility="{x:Bind IsSelected, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                <StackPanel Orientation="Horizontal" Spacing="10" Padding="8,6">
                    <controls:AssetIcon Monochrome="True" Width="24" Height="24" IconSource="{x:Bind OpenIcon, Mode=OneTime}" Glyph="{x:Bind Glyph, Mode=OneTime}" />
                    <TextBlock Text="{x:Bind Name, Mode=OneTime}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Grid>
        </DataTemplate>

        <!-- One class of the character editor's picker: its icon and its name. -->
        <DataTemplate x:Key="ClassChoiceTemplate" x:DataType="vm:ClassChoice">
            <StackPanel Orientation="Horizontal" Spacing="10" Padding="2">
                <controls:AssetIcon Monochrome="True"
                    Width="24"
                    Height="24"
                    IconSource="{x:Bind OpenIcon, Mode=OneTime}" />
                <TextBlock Text="{x:Bind Name, Mode=OneTime}" VerticalAlignment="Center" />
            </StackPanel>
        </DataTemplate>

        <!-- One cooldown slot of the board (1 to 20): its number, the skill in it, and the accent outline when selected.
             A click selects its step; a filled slot is dragged to another cell or out of the board, a step is dropped on it. -->
        <DataTemplate x:Key="CooldownCellTemplate" x:DataType="local:ApplyBoardCell">
            <Button
                Click="BoardCell_Click"
                Padding="0"
                Margin="0"
                MinHeight="46"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Stretch"
                VerticalContentAlignment="Stretch"
                Background="Transparent"
                BorderThickness="0"
                AllowDrop="True"
                CanDrag="{x:Bind HasStep, Mode=OneTime}"
                DragStarting="BoardCell_DragStarting"
                DragOver="BoardCell_DragOver"
                Drop="BoardCell_Drop"
                DropCompleted="Drag_Completed"
                AutomationProperties.Name="{x:Bind Caption, Mode=OneTime}"
                ToolTipService.ToolTip="{x:Bind Caption, Mode=OneTime}">
                <Grid>
                    <Border
                        CornerRadius="8"
                        BorderThickness="1"
                        Background="{ThemeResource ControlFillColorSecondaryBrush}"
                        BorderBrush="{ThemeResource GlassLineBrush}" />
                    <Border
                        CornerRadius="8"
                        BorderThickness="2"
                        BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                        Visibility="{x:Bind IsSelected, Mode=OneTime, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock
                        Text="{x:Bind Label, Mode=OneTime}"
                        Margin="6,4,0,0"
                        FontSize="10"
                        FontWeight="SemiBold"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    <controls:AssetIcon
                        Width="28"
                        Height="28"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Visibility="{x:Bind HasStep, Mode=OneTime, Converter={StaticResource BoolToVisibility}}"
                        controls:SkillTooltips.Skill="{x:Bind Step.PrimarySkill, Mode=OneTime}"
                        IconSource="{x:Bind Step.PrimarySkill.OpenIcon, Mode=OneTime}"
                        Glyph="{x:Bind Step.Glyph, Mode=OneTime}" />
                </Grid>
            </Button>
        </DataTemplate>

        <!-- One quick position of the board: its number, its input label when it has one, and the skill on it. Dragged and dropped
             like a cooldown cell. -->
        <DataTemplate x:Key="QuickCellTemplate" x:DataType="local:ApplyBoardCell">
            <Button
                Click="BoardCell_Click"
                Padding="0"
                Margin="0"
                MinHeight="40"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Stretch"
                VerticalContentAlignment="Stretch"
                Background="Transparent"
                BorderThickness="0"
                AllowDrop="True"
                CanDrag="{x:Bind HasStep, Mode=OneTime}"
                DragStarting="BoardCell_DragStarting"
                DragOver="BoardCell_DragOver"
                Drop="BoardCell_Drop"
                DropCompleted="Drag_Completed"
                AutomationProperties.Name="{x:Bind Caption, Mode=OneTime}"
                ToolTipService.ToolTip="{x:Bind Caption, Mode=OneTime}">
                <Grid>
                    <Border
                        CornerRadius="8"
                        BorderThickness="1"
                        Background="{ThemeResource ControlFillColorSecondaryBrush}"
                        BorderBrush="{ThemeResource GlassLineBrush}" />
                    <Border
                        CornerRadius="8"
                        BorderThickness="2"
                        BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                        Visibility="{x:Bind IsSelected, Mode=OneTime, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock
                        Text="{x:Bind Label, Mode=OneTime}"
                        Margin="3,2,0,0"
                        FontSize="9"
                        FontWeight="SemiBold"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    <TextBlock
                        Text="{x:Bind Input, Mode=OneTime}"
                        Margin="0,2,3,0"
                        FontSize="9"
                        FontWeight="SemiBold"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Visibility="{x:Bind HasInput, Mode=OneTime, Converter={StaticResource BoolToVisibility}}" />
                    <controls:AssetIcon
                        Width="20"
                        Height="20"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Visibility="{x:Bind HasStep, Mode=OneTime, Converter={StaticResource BoolToVisibility}}"
                        controls:SkillTooltips.Skill="{x:Bind Step.PrimarySkill, Mode=OneTime}"
                        IconSource="{x:Bind Step.PrimarySkill.OpenIcon, Mode=OneTime}"
                        Glyph="{x:Bind Step.Glyph, Mode=OneTime}" />
                </Grid>
            </Button>
        </DataTemplate>

        <!-- One step of a chain. The order of the list is the order of the combo. -->
        <DataTemplate x:Key="StepTemplate" x:DataType="vm:ComboStepViewModel">
            <Border
                Margin="0,2"
                Padding="8,6"
                BorderThickness="1"
                CornerRadius="14"
                AutomationProperties.Name="{x:Bind AutomationName, Mode=OneWay}"
                Style="{x:Bind local:ApplyComboPage.CardStyle(IsSelected), Mode=OneWay}">
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        Text="{x:Bind Position, Mode=OneWay}"
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        FontSize="12" />

                    <controls:AssetIcon
                        Grid.Column="1"
                        Width="36"
                        Height="36"
                        controls:SkillTooltips.Skill="{x:Bind PrimarySkill, Mode=OneWay}"
                        IconSource="{x:Bind PrimarySkill.OpenIcon, Mode=OneWay}"
                        Glyph="{x:Bind Glyph, Mode=OneWay}" />

                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="3">
                        <TextBlock
                            Text="{x:Bind DisplayName, Mode=OneWay}"
                            FontWeight="SemiBold"
                            TextTrimming="CharacterEllipsis" />
                        <Border
                            HorizontalAlignment="Left"
                            Padding="6,1"
                            CornerRadius="6"
                            BorderThickness="1"
                            BorderBrush="{ThemeResource GlassLineBrush}"
                            Background="{ThemeResource GlassChipBrush}">
                            <TextBlock
                                Text="{x:Bind KeyLegend, Mode=OneWay}"
                                FontSize="11"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextTrimming="CharacterEllipsis" />
                        </Border>
                        <TextBlock
                            Text="{x:Bind Memo, Mode=OneWay}"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextTrimming="CharacterEllipsis"
                            Visibility="{x:Bind local:ApplyComboPage.MemoLineVisibility(HasMemo, IsHotkey), Mode=OneWay}" />
                    </StackPanel>

                    <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <Border
                            Padding="6,2"
                            CornerRadius="6"
                            Background="{ThemeResource AccentFillColorDefaultBrush}"
                            Visibility="{x:Bind HasCooldown, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock
                                Text="{x:Bind CooldownLabel, Mode=OneWay}"
                                FontSize="12"
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                        </Border>
                        <Border
                            Padding="6,2"
                            CornerRadius="6"
                            BorderThickness="1"
                            BorderBrush="{ThemeResource GlassLineBrush}"
                            Background="{ThemeResource GlassChipBrush}"
                            Visibility="{x:Bind HasQuick, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock
                                Text="{x:Bind QuickLabel, Mode=OneWay}"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- One step of the mobility pool. The skill gets a free cooldown slot only when the user asks for it. -->
        <DataTemplate x:Key="ManualStepTemplate" x:DataType="vm:ComboStepViewModel">
            <Border
                Margin="0,2"
                Padding="8,6"
                CornerRadius="14"
                BorderThickness="1"
                BorderBrush="{ThemeResource GlassLineBrush}"
                Background="{ThemeResource ControlFillColorSecondaryBrush}"
                CanDrag="True"
                DragStarting="ManualStep_DragStarting"
                DropCompleted="Drag_Completed">
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <controls:AssetIcon
                        Width="36"
                        Height="36"
                        controls:SkillTooltips.Skill="{x:Bind PrimarySkill, Mode=OneWay}"
                        IconSource="{x:Bind PrimarySkill.OpenIcon, Mode=OneWay}"
                        Glyph="{x:Bind Glyph, Mode=OneWay}" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="{x:Bind DisplayName, Mode=OneWay}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            Text="{x:Bind CooldownLabel, Mode=OneWay}"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Visibility="{x:Bind HasCooldown, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                    <Button
                        Grid.Column="2"
                        x:Uid="Apply/AddToSlotButton"
                        VerticalAlignment="Center"
                        Click="AddToSlot_Click"
                        Visibility="{x:Bind HasCooldown, Mode=OneWay, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}" />
                </Grid>
            </Border>
        </DataTemplate>

        <!-- One skill of the "Add skill" picker. The list's ItemClick adds it to the chain it was opened from. -->
        <DataTemplate x:Key="SkillOptionTemplate" x:DataType="vm:SkillOption">
            <TextBlock
                Text="{x:Bind Name, Mode=OneTime}"
                Padding="8,6"
                TextTrimming="CharacterEllipsis"
                controls:SkillTooltips.Skill="{x:Bind Skill, Mode=OneTime}" />
        </DataTemplate>

        <!-- One chain of the guide: its title, its notes, its steps, and the "Add skill" picker. -->
        <DataTemplate x:Key="ChainTemplate" x:DataType="vm:ComboChainViewModel">
            <StackPanel Margin="0,0,0,12" Spacing="4">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="2">
                        <TextBlock Text="{x:Bind Title, Mode=OneWay}" Style="{ThemeResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" />
                        <TextBlock
                            Text="{x:Bind NotesText, Mode=OneWay}"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <TextBlock
                        Grid.Column="1"
                        Text="{x:Bind StepCountText, Mode=OneWay}"
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <Button Grid.Column="2" x:Uid="Apply/AddSkillButton" VerticalAlignment="Center">
                        <Button.Flyout>
                            <Flyout>
                                <controls:SearchableList
                                    Tag="{x:Bind}"
                                    Width="320"
                                    ItemsSource="{x:Bind AvailableSkills, Mode=OneWay}"
                                    ItemTemplate="{StaticResource SkillOptionTemplate}"
                                    FieldsOf="{x:Bind local:ApplyComboPage.SkillSearchFields, Mode=OneTime}"
                                    ItemChosen="AddSkill_ItemChosen" />
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                </Grid>

                <ListView
                    Tag="{x:Bind}"
                    ItemsSource="{x:Bind Steps, Mode=OneWay}"
                    ItemTemplate="{StaticResource StepTemplate}"
                    SelectionMode="None"
                    IsItemClickEnabled="True"
                    ItemClick="Step_ItemClick"
                    CanDragItems="True"
                    CanReorderItems="True"
                    AllowDrop="True"
                    DragItemsStarting="Steps_DragItemsStarting"
                    DragItemsCompleted="Steps_DragItemsCompleted"
                    DragOver="Steps_DragOver"
                    Padding="0"
                    Background="Transparent">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="MinHeight" Value="0" />
                        </Style>
                    </ListView.ItemContainerStyle>
                </ListView>
            </StackPanel>
        </DataTemplate>

        <!-- A guide spec (Awakening, Succession, ...). The selected one takes the accent. -->
        <DataTemplate x:Key="SpecTemplate" x:DataType="vm:SpecOptionViewModel">
            <Button
                Command="{x:Bind SelectCommand}"
                Style="{x:Bind local:ApplyComboPage.PillStyle(IsSelected), Mode=OneWay}"
                Margin="0,0,8,0"
                Content="{x:Bind Label, Mode=OneWay}" />
        </DataTemplate>

        <!-- One of the ten custom combo slots: its number and its name, or "empty". -->
        <DataTemplate x:Key="ComboSlotTemplate" x:DataType="vm:ComboSlotOption">
            <TextBlock
                Text="{x:Bind Label, Mode=OneWay}"
                Padding="8,6"
                TextTrimming="CharacterEllipsis" />
        </DataTemplate>

        <!-- The slot the selector shows in the compact row: its label and a chevron, without the list row's padding. -->
        <DataTemplate x:Key="ComboSlotSelectedTemplate" x:DataType="vm:ComboSlotOption">
            <Grid ColumnSpacing="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{x:Bind Label, Mode=OneWay}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <FontIcon Grid.Column="1" Glyph="&#xE70D;" FontSize="10" VerticalAlignment="Center" />
            </Grid>
        </DataTemplate>

        <!-- One class add-on of the guide: icon, name, the guide's description and its effects as label and value. -->
        <DataTemplate x:Key="AddonTemplate" x:DataType="vm:ComboAddonViewModel">
            <Border
                Margin="0,2"
                Padding="8,6"
                CornerRadius="14"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderThickness="1"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                <StackPanel Spacing="6">
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <controls:AssetIcon
                            Width="36"
                            Height="36"
                            IconSource="{x:Bind OpenIcon, Mode=OneTime}"
                            Glyph="{x:Bind Glyph, Mode=OneTime}" />
                        <TextBlock
                            Grid.Column="1"
                            Text="{x:Bind Name, Mode=OneTime}"
                            FontWeight="SemiBold"
                            VerticalAlignment="Center"
                            TextTrimming="CharacterEllipsis" />
                    </Grid>
                    <TextBlock
                        Text="{x:Bind Description, Mode=OneTime}"
                        TextWrapping="Wrap"
                        FontSize="13"
                        Visibility="{x:Bind HasDescription, Mode=OneTime, Converter={StaticResource BoolToVisibility}}" />
                    <ItemsControl ItemsSource="{x:Bind Effects, Mode=OneTime}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ComboAddonEffectViewModel">
                                <Grid ColumnSpacing="10" Margin="0,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="170" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        Text="{x:Bind Label, Mode=OneTime}"
                                        FontSize="12"
                                        TextWrapping="Wrap"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock
                                        Grid.Column="1"
                                        Text="{x:Bind Value, Mode=OneTime}"
                                        FontSize="12"
                                        TextWrapping="Wrap" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <Grid Padding="16" ColumnSpacing="12" RowSpacing="10">
        <Grid.ColumnDefinitions>
            <!-- The side columns shrink with the window down to their minimums; the center keeps its 320 pixels. -->
            <ColumnDefinition Width="0.8*" MinWidth="200" MaxWidth="300" />
            <ColumnDefinition Width="*" MinWidth="320" />
            <ColumnDefinition Width="0.95*" MinWidth="240" MaxWidth="380" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Left panel: the account and its character, then the searchable class list. -->
        <Border Style="{StaticResource GlassCardStyle}" Padding="10">
            <Grid RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Spacing="2" Padding="6,4,6,0">
                    <TextBlock x:Uid="Apply/Title" Style="{ThemeResource TitleTextBlockStyle}" />
                    <TextBlock
                        Text="{x:Bind ViewModel.ActiveAccountText, Mode=OneWay}"
                        FontSize="12"
                        TextWrapping="Wrap"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>

                <!-- The character of the whole app is chosen here, once: choosing a class with several characters asks which one. -->
                <StackPanel Grid.Row="1" Spacing="6" Padding="6,0">
                    <TextBlock x:Uid="Apply/CharacterHeader" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ContentControl
                            Content="{x:Bind ViewModel.SelectedCharacter, Mode=OneWay}"
                            ContentTemplate="{StaticResource SelectedCharacterTemplate}"
                            HorizontalContentAlignment="Left"
                            VerticalAlignment="Center" />
                        <Button Grid.Column="1" x:Uid="Apply/ChangeCharacterButton" Click="ChangeCharacter_Click" />
                    </Grid>
                    <TextBlock
                        Text="{x:Bind ViewModel.CharactersMessage, Mode=OneWay}"
                        FontSize="12"
                        TextWrapping="Wrap"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>

                <TextBlock Grid.Row="2" x:Uid="Apply/ClassHeader" Style="{ThemeResource BodyStrongTextBlockStyle}" Padding="6,0" />

                <!-- The classes with a guide. Searching matches the Spanish and the English name. -->
                <!-- The class list scrolls inside its own row when the window is short; the card's edges never move. -->
                <controls:SearchableList
                    x:Name="ClassList"
                    Grid.Row="3"
                    ListMaxHeight="Infinity"
                    ItemsSource="{x:Bind ViewModel.Classes, Mode=OneWay}"
                    ItemTemplate="{StaticResource ClassRowTemplate}"
                    ItemChosen="ClassList_ItemChosen" />
            </Grid>
        </Border>

        <!-- Center panel: the guide (title, guide switch, tabs of its chains), the review and the chains. -->
        <Border Grid.Column="1" Style="{StaticResource GlassCardStyle}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- The guide heading and its actions. The guide is never written from here. -->
                <Grid Padding="18,16,18,10" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="3" VerticalAlignment="Center">
                        <TextBlock
                            Text="{x:Bind ViewModel.Editor.Title, Mode=OneWay}"
                            Style="{ThemeResource SubtitleTextBlockStyle}"
                            TextWrapping="Wrap" />
                        <TextBlock
                            Text="{x:Bind local:ApplyComboPage.GuideMetaText(ViewModel.ClassName, ViewModel.Editor.SourceHost, ViewModel.ProfileStateText), Mode=OneWay}"
                            FontSize="12"
                            TextTrimming="CharacterEllipsis"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button
                            x:Uid="Apply/OpenEditorButton"
                            Click="OpenEditor_Click"
                            IsEnabled="{x:Bind ViewModel.CanRun, Mode=OneWay}" />
                    </StackPanel>
                </Grid>

                <!-- My combos: one compact row under the guide heading. The name stays visible; Save writes the selected slot. -->
                <Grid
                    Grid.Row="1"
                    Padding="18,0,18,12"
                    ColumnSpacing="8"
                    Visibility="{x:Bind ViewModel.HasEditor, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="110" />
                        <ColumnDefinition Width="1.3*" MinWidth="100" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <controls:SearchablePicker
                        x:Name="ComboSlotPicker"
                        MinHeight="30"
                        HorizontalAlignment="Stretch"
                        ItemsSource="{x:Bind ViewModel.ComboSlots, Mode=OneWay}"
                        ItemTemplate="{StaticResource ComboSlotTemplate}"
                        SelectedItem="{x:Bind ViewModel.SelectedComboSlot, Mode=OneWay}"
                        SelectedTemplate="{StaticResource ComboSlotSelectedTemplate}"
                        Chosen="ComboSlotPicker_Chosen" />
                    <TextBox
                        Grid.Column="1"
                        x:Uid="Apply/ComboNameBox"
                        Text="{x:Bind ViewModel.ComboName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        MaxLength="60"
                        VerticalAlignment="Center" />
                    <Button
                        Grid.Column="2"
                        x:Uid="Apply/SaveSlotButton"
                        Command="{x:Bind ViewModel.SaveProfileCommand}"
                        Style="{StaticResource AccentButtonStyle}" />
                    <Button Grid.Column="3" x:Uid="Apply/ComboMoreButton">
                        <Button.Flyout>
                            <MenuFlyout>
                                <MenuFlyoutItem x:Uid="Apply/LoadSlotMenuItem" Command="{x:Bind ViewModel.LoadProfileCommand}" />
                                <MenuFlyoutItem x:Uid="Apply/DeleteSlotMenuItem" Command="{x:Bind ViewModel.DeleteProfileCommand}" />
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem x:Uid="Apply/RestoreMenuItem" Command="{x:Bind ViewModel.RestoreBaseCommand}" />
                                <MenuFlyoutItem x:Uid="Apply/ImportMenuItem" Command="{x:Bind ViewModel.ImportCurrentComboCommand}" />
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                </Grid>

                <!-- The guide switch: one pill per spec of the class. -->
                <StackPanel Grid.Row="2" Padding="18,0,18,12" Spacing="6">
                    <TextBlock x:Uid="Apply/GuideHeader" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <ItemsControl
                            ItemsSource="{x:Bind ViewModel.Specs, Mode=OneWay}"
                            ItemTemplate="{StaticResource SpecTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>

                <!-- The chains: buffs and combos in the guide's order, then the class add-ons and the mobility pool. -->
                <!-- A board cell's step dropped anywhere on the chains takes it out of its cell (see ChainsArea_Drop). -->
                <ScrollViewer x:Name="ChainsScroll" Grid.Row="3" VerticalScrollBarVisibility="Auto" Padding="18,4,18,16" AllowDrop="True">
                    <StackPanel Spacing="0" Padding="0,0,6,0">
                        <StackPanel
                            Spacing="8"
                            Visibility="{x:Bind ViewModel.HasEditor, Mode=OneWay, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}">
                            <TextBlock x:Uid="Apply/EmptyTitle" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                            <TextBlock
                                x:Uid="Apply/EmptyBody"
                                TextWrapping="Wrap"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>

                        <ItemsControl
                            ItemsSource="{x:Bind ViewModel.Editor.Chains, Mode=OneWay}"
                            ItemTemplate="{StaticResource ChainTemplate}" />

                        <!-- Class add-ons: read-only information of the guide. -->
                        <StackPanel
                            Spacing="6"
                            Margin="0,10,0,0"
                            Visibility="{x:Bind ViewModel.Editor.HasAddons, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock x:Uid="Apply/SectionAddons" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                            <ItemsControl
                                ItemsSource="{x:Bind ViewModel.Editor.Addons, Mode=OneWay}"
                                ItemTemplate="{StaticResource AddonTemplate}" />
                        </StackPanel>

                        <StackPanel
                            Spacing="4"
                            Margin="0,10,0,0"
                            Visibility="{x:Bind ViewModel.Editor.HasManualSteps, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock x:Uid="Apply/SectionMobility" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                            <ItemsControl ItemsSource="{x:Bind ViewModel.Editor.ManualChains, Mode=OneWay}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ComboChainViewModel">
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="{x:Bind Title, Mode=OneWay}" FontWeight="SemiBold" Margin="0,8,0,0" />
                                            <ItemsControl ItemsSource="{x:Bind Steps, Mode=OneWay}" ItemTemplate="{StaticResource ManualStepTemplate}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <TextBlock
                            x:Uid="Apply/GuideMissing"
                            Visibility="{x:Bind ViewModel.IsGuideMissing, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                            TextWrapping="Wrap"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Right panel: the 20 cooldown slots, the quick positions and the selected step. It scrolls; the footer stays. -->
        <Border Grid.Column="2" Style="{StaticResource GlassCardStyle}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ScrollViewer Padding="18,16,18,8" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="12" Padding="0,0,6,0">
                        <!-- The cooldown bar: 20 slots, five by four. Tap a slot to select its step. -->
                        <StackPanel Spacing="8">
                            <TextBlock x:Uid="Apply/CooldownBoardHeader" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                            <mux:ItemsRepeater ItemsSource="{x:Bind CooldownCells, Mode=OneWay}" ItemTemplate="{StaticResource CooldownCellTemplate}">
                                <mux:ItemsRepeater.Layout>
                                    <mux:UniformGridLayout MaximumRowsOrColumns="5" MinRowSpacing="6" MinColumnSpacing="6" ItemsStretch="Fill" />
                                </mux:ItemsRepeater.Layout>
                            </mux:ItemsRepeater>
                        </StackPanel>

                        <!-- The quick bar: every quick position, five by four like the cooldown bar, with their inputs. -->
                        <StackPanel Spacing="8">
                            <TextBlock x:Uid="Apply/QuickBoardHeader" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                            <mux:ItemsRepeater ItemsSource="{x:Bind QuickCells, Mode=OneWay}" ItemTemplate="{StaticResource QuickCellTemplate}">
                                <mux:ItemsRepeater.Layout>
                                    <mux:UniformGridLayout MaximumRowsOrColumns="5" MinRowSpacing="6" MinColumnSpacing="6" ItemsStretch="Fill" />
                                </mux:ItemsRepeater.Layout>
                            </mux:ItemsRepeater>
                        </StackPanel>

                        <!-- The selected step: its skill, its guide notes, and the customization. -->
                        <StackPanel Spacing="10">
                            <TextBlock x:Uid="Apply/StepDetailHeader" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                            <TextBlock
                                x:Uid="Apply/DetailEmpty"
                                TextWrapping="Wrap"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Visibility="{x:Bind ViewModel.Editor.HasSelection, Mode=OneWay, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}" />

                            <StackPanel
                                Spacing="10"
                                Visibility="{x:Bind ViewModel.Editor.HasSelection, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <controls:AssetIcon
                                        Width="52"
                                        Height="52"
                                        controls:SkillTooltips.Skill="{x:Bind ViewModel.Editor.SelectedStep.PrimarySkill, Mode=OneWay}"
                                        IconSource="{x:Bind ViewModel.Editor.SelectedStep.PrimarySkill.OpenIcon, Mode=OneWay}"
                                        Glyph="{x:Bind ViewModel.Editor.SelectedStep.Glyph, Mode=OneWay}" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                        <TextBlock
                                            Text="{x:Bind ViewModel.Editor.SelectedStep.SkillName, Mode=OneWay}"
                                            Style="{ThemeResource BodyStrongTextBlockStyle}"
                                            TextWrapping="Wrap" />
                                        <TextBlock
                                            Text="{x:Bind ViewModel.Editor.SelectedStep.KeyLegend, Mode=OneWay}"
                                            FontSize="12"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </Grid>

                                <StackPanel
                                    Spacing="4"
                                    Visibility="{x:Bind ViewModel.Editor.SelectedStep.HasDescription, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock x:Uid="Apply/DescriptionHeader" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock
                                        Text="{x:Bind ViewModel.Editor.SelectedStep.SkillDescription, Mode=OneWay}"
                                        TextWrapping="Wrap"
                                        FontSize="13" />
                                </StackPanel>

                                <StackPanel
                                    Spacing="4"
                                    Visibility="{x:Bind ViewModel.Editor.SelectedStep.HasGuideNotes, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock x:Uid="Apply/GuideNotesHeader" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock
                                        Text="{x:Bind ViewModel.Editor.SelectedStep.GuideNotes, Mode=OneWay}"
                                        TextWrapping="Wrap"
                                        FontSize="13" />
                                </StackPanel>

                                <TextBlock x:Uid="Apply/CustomizationHeader" Style="{ThemeResource BodyStrongTextBlockStyle}" Margin="0,6,0,0" />
                                <TextBox
                                    x:Uid="Apply/MemoBox"
                                    Text="{x:Bind ViewModel.Editor.SelectedStep.Memo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                <Grid ColumnSpacing="6" Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button x:Uid="Apply/MoveEarlierButton" Command="{x:Bind ViewModel.Editor.MoveEarlierCommand}" HorizontalAlignment="Stretch" />
                                    <Button Grid.Column="1" x:Uid="Apply/MoveLaterButton" Command="{x:Bind ViewModel.Editor.MoveLaterCommand}" HorizontalAlignment="Stretch" />
                                    <Button Grid.Column="2" x:Uid="Apply/RemoveButton" Command="{x:Bind ViewModel.Editor.RemoveSelectedCommand}" HorizontalAlignment="Stretch" />
                                </Grid>
                                <Button x:Uid="Apply/ResetStepButton" Command="{x:Bind ViewModel.Editor.ResetStepCommand}" HorizontalAlignment="Stretch" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- The footer, always visible: combos are not written from this page, Preview does it. -->
                <Border Grid.Row="1" Padding="16,10,16,12" BorderThickness="0,1,0,0" BorderBrush="{ThemeResource GlassLineBrush}">
                    <Button
                        x:Uid="Apply/GoToPreviewButton"
                        Style="{StaticResource AccentButtonStyle}"
                        HorizontalAlignment="Stretch"
                        Click="GoToPreview_Click" />
                </Border>
            </Grid>
        </Border>

        <!-- The outcome of the last action. -->
        <InfoBar
            Grid.Row="1"
            Grid.ColumnSpan="3"
            IsOpen="{x:Bind ViewModel.IsStatusOpen, Mode=TwoWay}"
            Severity="{x:Bind ToInfoBarSeverity(ViewModel.StatusSeverity), Mode=OneWay}"
            Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
            IsClosable="True" />
    </Grid>
</Page>
