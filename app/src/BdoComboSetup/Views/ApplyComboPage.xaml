<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="BdoComboSetup.Views.ApplyComboPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:core="using:BdoComboSetup.Core.Combo"
    >

    <ScrollViewer Padding="32,24">
        <StackPanel Spacing="16" MaxWidth="760" HorizontalAlignment="Left">
            <TextBlock x:Uid="ApplyTitle" Style="{StaticResource TitleLargeTextBlockStyle}" />

            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <ComboBox
                    x:Uid="CharacterComboBox"
                    HorizontalAlignment="Stretch"
                    ItemsSource="{x:Bind ViewModel.Characters}"
                    SelectedItem="{x:Bind ViewModel.SelectedCharacter, Mode=TwoWay}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="core:CharacterOption">
                            <StackPanel Spacing="2">
                                <TextBlock Text="{x:Bind Name}" />
                                <TextBlock Text="{x:Bind Pcid}" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7" />
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <ComboBox
                    Grid.Column="1"
                    x:Uid="ClassComboBox"
                    HorizontalAlignment="Stretch"
                    ItemsSource="{x:Bind ViewModel.ClassNames}"
                    SelectedItem="{x:Bind ViewModel.SelectedClassName, Mode=TwoWay}" />
            </Grid>

            <StackPanel Spacing="8">
                <TextBlock x:Uid="ModeHeader" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <RadioButton
                        x:Uid="ModeSuccessionRadio"
                        GroupName="ModeGroup"
                        IsChecked="{x:Bind ViewModel.IsSuccession, Mode=TwoWay}" />
                    <RadioButton
                        x:Uid="ModeAwakeningRadio"
                        GroupName="ModeGroup"
                        IsChecked="{x:Bind ViewModel.IsAwakening, Mode=TwoWay}" />
                </StackPanel>
            </StackPanel>

            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="8">
                    <TextBlock
                        Text="{x:Bind ViewModel.SummaryTitle, Mode=OneWay}"
                        Style="{StaticResource SubtitleTextBlockStyle}"
                        TextWrapping="Wrap" />
                    <TextBlock Text="{x:Bind ViewModel.SummaryDescription, Mode=OneWay}" TextWrapping="Wrap" />
                    <TextBlock
                        Text="{x:Bind ViewModel.SummarySource, Mode=OneWay}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Opacity="0.7" />

                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                        <Border Padding="10,4" CornerRadius="4" Background="{ThemeResource ControlFillColorSecondaryBrush}">
                            <TextBlock Text="{x:Bind ViewModel.ComboSkillsText, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" />
                        </Border>
                        <Border Padding="10,4" CornerRadius="4" Background="{ThemeResource ControlFillColorSecondaryBrush}">
                            <TextBlock Text="{x:Bind ViewModel.PriorityBuffsText, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" />
                        </Border>
                        <Border Padding="10,4" CornerRadius="4" Background="{ThemeResource ControlFillColorSecondaryBrush}">
                            <TextBlock Text="{x:Bind ViewModel.QuickSlotsText, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" />
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Border>

            <StackPanel Spacing="4">
                <CheckBox x:Uid="CooldownBarCheckBox" IsChecked="{x:Bind ViewModel.IncludeCooldownBar, Mode=TwoWay}" />
                <CheckBox x:Uid="MemosCheckBox" IsChecked="{x:Bind ViewModel.IncludeMemos, Mode=TwoWay}" />
                <CheckBox x:Uid="QuickSlotsCheckBox" IsChecked="{x:Bind ViewModel.IncludeQuickSlots, Mode=TwoWay}" />
            </StackPanel>

            <InfoBar
                x:Uid="BackupInfoBar"
                IsOpen="True"
                IsClosable="False"
                Severity="Informational" />

            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button
                    x:Uid="ApplyButton"
                    Style="{StaticResource AccentButtonStyle}"
                    Command="{x:Bind ViewModel.ApplyCommand}" />
                <Button
                    x:Uid="DryRunButton"
                    Command="{x:Bind ViewModel.DryRunCommand}" />
            </StackPanel>

            <InfoBar
                x:Name="StatusInfoBar"
                IsClosable="True"
                IsOpen="{x:Bind ViewModel.IsStatusOpen, Mode=TwoWay}"
                Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                Severity="{x:Bind ToInfoBarSeverity(ViewModel.StatusSeverity), Mode=OneWay}" />
        </StackPanel>
    </ScrollViewer>
</Page>
