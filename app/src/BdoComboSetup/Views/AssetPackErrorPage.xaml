<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="BdoComboSetup.Views.AssetPackErrorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Shown instead of the modules when assets.bdoa is missing or invalid. All texts come from the .resw files. -->
    <ScrollViewer Padding="32">
        <StackPanel Spacing="12" MaxWidth="720" HorizontalAlignment="Left">
            <SymbolIcon Symbol="Important" Foreground="{ThemeResource SystemFillColorCriticalBrush}">
                <SymbolIcon.RenderTransform>
                    <ScaleTransform ScaleX="2" ScaleY="2" />
                </SymbolIcon.RenderTransform>
            </SymbolIcon>
            <TextBlock x:Name="TitleText" Style="{ThemeResource TitleTextBlockStyle}" TextWrapping="Wrap" Margin="0,12,0,0" />
            <TextBlock x:Name="BodyText" TextWrapping="Wrap" />
            <TextBlock x:Name="DetailText" TextWrapping="Wrap" IsTextSelectionEnabled="True" Opacity="0.7" />
        </StackPanel>
    </ScrollViewer>
</Page>
