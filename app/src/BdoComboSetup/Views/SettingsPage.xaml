<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="BdoComboSetup.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:BdoComboSetup.Core.ViewModels"
    xmlns:combo="using:BdoComboSetup.Core.Combo"
    xmlns:local="using:BdoComboSetup.Views"
    xmlns:controls="using:BdoComboSetup.Views.Controls"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.Resources>
        <!-- A round accent swatch. The fill of each swatch is set in code-behind (the page's accent palette, per theme). -->
        <!-- Transparent background so the hover state does not repaint the color. -->
        <Style x:Key="AccentSwatchStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="CornerRadius" Value="16" />
        </Style>

        <!-- One account of the data folder: its label ("Cuenta 100000001"). -->
        <DataTemplate x:Key="AccountChoiceTemplate" x:DataType="vm:AccountChoice">
            <TextBlock Text="{x:Bind Label, Mode=OneTime}" VerticalAlignment="Center" />
        </DataTemplate>

        <!-- One character of the active account: class icon, name, class, and the per-row Edit and Reset actions. -->
        <DataTemplate x:Key="CharacterRowTemplate" x:DataType="combo:CharacterOption">
            <Grid ColumnSpacing="10" Padding="4,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <controls:AssetIcon
                    Width="28"
                    Height="28"
                    IconSource="{x:Bind local:ApplyComboPage.ClassIconOf(ClassType), Mode=OneTime}"
                    Glyph="{x:Bind local:ApplyComboPage.ClassGlyphOf(ClassType), Mode=OneTime}" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                    <TextBlock Text="{x:Bind Name, Mode=OneTime}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        Text="{x:Bind local:SettingsPage.ClassNameOf(ClassType), Mode=OneTime}"
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <Button Grid.Column="2" x:Uid="Settings/EditCharacterButton" VerticalAlignment="Center" Click="EditCharacter_Click" />
                <Button Grid.Column="3" x:Uid="Settings/ResetCharacterButton" VerticalAlignment="Center" Click="ResetCharacter_Click" />
            </Grid>
        </DataTemplate>

        <!-- One class of the edit flyout's picker: its icon and its name. -->
        <DataTemplate x:Key="ClassChoiceTemplate" x:DataType="vm:ClassChoice">
            <StackPanel Orientation="Horizontal" Spacing="10" Padding="2">
                <controls:AssetIcon Width="24" Height="24" IconSource="{x:Bind OpenIcon, Mode=OneTime}" />
                <TextBlock Text="{x:Bind Name, Mode=OneTime}" VerticalAlignment="Center" />
            </StackPanel>
        </DataTemplate>

        <!-- One row of the OCR review: the name (editable), the level read, and the class (editable). -->
        <DataTemplate x:Key="ScanRowTemplate" x:DataType="vm:CharacterScanRow">
            <Grid ColumnSpacing="10" Padding="4,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="64" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    Text="{x:Bind Order, Mode=OneTime}"
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Spacing="2">
                    <TextBox Text="{x:Bind Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MaxLength="40" />
                    <TextBlock
                        Text="{x:Bind MemoText, Mode=OneTime}"
                        FontSize="11"
                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                        Visibility="{x:Bind HasMemo, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock
                        Text="{x:Bind PreviousText, Mode=OneTime}"
                        FontSize="11"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Visibility="{x:Bind HasPreviousName, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
                <TextBlock
                    Grid.Column="2"
                    Text="{x:Bind LevelText, Mode=OneTime}"
                    FontSize="12"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <controls:SearchablePicker
                    Grid.Column="3"
                    MinWidth="190"
                    Tag="{x:Bind}"
                    ItemsSource="{x:Bind Classes, Mode=OneTime}"
                    ItemTemplate="{StaticResource ClassChoiceTemplate}"
                    SelectedItem="{x:Bind Class, Mode=OneWay}"
                    SelectedTemplate="{StaticResource ClassChoiceTemplate}"
                    FieldsOf="{x:Bind local:SettingsPage.ClassChoiceFields, Mode=OneTime}"
                    Chosen="ScanClassPicker_Chosen" />
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <ScrollViewer Padding="32,24,32,32" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="14" MaxWidth="1080" HorizontalAlignment="Left">

            <!-- Heading -->
            <Grid ColumnSpacing="12" Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <FontIcon Glyph="&#xE713;"
                    FontSize="26"
                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                    VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Spacing="2">
                    <TextBlock x:Uid="Settings/Title" Style="{ThemeResource TitleTextBlockStyle}" />
                    <TextBlock
                        x:Uid="Settings/Subtitle"
                        TextWrapping="Wrap"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Grid>

            <!-- Changes that only take effect after a restart (language, data folder, Preview account). -->
            <InfoBar
                x:Uid="Settings/RestartBar"
                IsOpen="{x:Bind ViewModel.RestartRequired, Mode=OneWay}"
                Severity="Warning"
                IsClosable="False">
                <InfoBar.ActionButton>
                    <Button x:Uid="Settings/RestartButton" Click="Restart_Click" />
                </InfoBar.ActionButton>
            </InfoBar>

            <!-- The cards: two columns. The characters, the scan and the wide cards span both columns. -->
            <Grid ColumnSpacing="14" RowSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Appearance: the theme (follows Windows or fixed), the accent color for the theme, and the side menu. Applies at once. -->
                <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="16">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE790;"
                                FontSize="20"
                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                VerticalAlignment="Top"
                                Margin="0,2,0,0" />
                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock x:Uid="Settings/Appearance/Header" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                <TextBlock
                                    x:Uid="Settings/Appearance/Hint"
                                    TextWrapping="Wrap"
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Grid>

                        <!-- Theme: three pills. The selected one is filled with the accent (set in code-behind). -->
                        <StackPanel Spacing="8">
                            <TextBlock x:Uid="Settings/Appearance/ThemeHeader" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                            <TextBlock
                                x:Uid="Settings/Appearance/ThemeHint"
                                TextWrapping="Wrap"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button
                                    x:Name="ThemeSystemButton"
                                    x:Uid="Settings/Appearance/ThemeSystem"
                                    Tag="system"
                                    Click="Theme_Click"
                                    Style="{StaticResource PillStyle}" />
                                <Button
                                    x:Name="ThemeLightButton"
                                    x:Uid="Settings/Appearance/ThemeLight"
                                    Tag="light"
                                    Click="Theme_Click"
                                    Style="{StaticResource PillStyle}" />
                                <Button
                                    x:Name="ThemeDarkButton"
                                    x:Uid="Settings/Appearance/ThemeDark"
                                    Tag="dark"
                                    Click="Theme_Click"
                                    Style="{StaticResource PillStyle}" />
                            </StackPanel>
                        </StackPanel>

                        <!-- Accent color: the name of the chosen accent beside its title; five swatches, the chosen one has a ring. -->
                        <StackPanel Spacing="8">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock x:Uid="Settings/Appearance/AccentHeader" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                <TextBlock
                                    Text="{x:Bind local:SettingsPage.AccentNameOf(ViewModel.AccentColor), Mode=OneWay}"
                                    Style="{ThemeResource BodyStrongTextBlockStyle}"
                                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Grid Width="40" Height="40">
                                    <Button x:Uid="Settings/Appearance/SwatchViolet" Tag="violet" Click="Accent_Click" Style="{StaticResource AccentSwatchStyle}">
                                        <Ellipse x:Name="SwatchFillViolet" Width="32" Height="32" />
                                    </Button>
                                    <Border
                                        x:Name="AccentRingViolet"
                                        Width="40"
                                        Height="40"
                                        CornerRadius="20"
                                        BorderThickness="2"
                                        BorderBrush="{ThemeResource TextFillColorPrimaryBrush}"
                                        IsHitTestVisible="False"
                                        Visibility="Collapsed" />
                                </Grid>
                                <Grid Width="40" Height="40">
                                    <Button x:Uid="Settings/Appearance/SwatchAmber" Tag="amber" Click="Accent_Click" Style="{StaticResource AccentSwatchStyle}">
                                        <Ellipse x:Name="SwatchFillAmber" Width="32" Height="32" />
                                    </Button>
                                    <Border
                                        x:Name="AccentRingAmber"
                                        Width="40"
                                        Height="40"
                                        CornerRadius="20"
                                        BorderThickness="2"
                                        BorderBrush="{ThemeResource TextFillColorPrimaryBrush}"
                                        IsHitTestVisible="False"
                                        Visibility="Collapsed" />
                                </Grid>
                                <Grid Width="40" Height="40">
                                    <Button x:Uid="Settings/Appearance/SwatchMint" Tag="mint" Click="Accent_Click" Style="{StaticResource AccentSwatchStyle}">
                                        <Ellipse x:Name="SwatchFillMint" Width="32" Height="32" />
                                    </Button>
                                    <Border
                                        x:Name="AccentRingMint"
                                        Width="40"
                                        Height="40"
                                        CornerRadius="20"
                                        BorderThickness="2"
                                        BorderBrush="{ThemeResource TextFillColorPrimaryBrush}"
                                        IsHitTestVisible="False"
                                        Visibility="Collapsed" />
                                </Grid>
                                <Grid Width="40" Height="40">
                                    <Button x:Uid="Settings/Appearance/SwatchRose" Tag="rose" Click="Accent_Click" Style="{StaticResource AccentSwatchStyle}">
                                        <Ellipse x:Name="SwatchFillRose" Width="32" Height="32" />
                                    </Button>
                                    <Border
                                        x:Name="AccentRingRose"
                                        Width="40"
                                        Height="40"
                                        CornerRadius="20"
                                        BorderThickness="2"
                                        BorderBrush="{ThemeResource TextFillColorPrimaryBrush}"
                                        IsHitTestVisible="False"
                                        Visibility="Collapsed" />
                                </Grid>
                                <Grid Width="40" Height="40">
                                    <Button x:Uid="Settings/Appearance/SwatchBlue" Tag="blue" Click="Accent_Click" Style="{StaticResource AccentSwatchStyle}">
                                        <Ellipse x:Name="SwatchFillBlue" Width="32" Height="32" />
                                    </Button>
                                    <Border
                                        x:Name="AccentRingBlue"
                                        Width="40"
                                        Height="40"
                                        CornerRadius="20"
                                        BorderThickness="2"
                                        BorderBrush="{ThemeResource TextFillColorPrimaryBrush}"
                                        IsHitTestVisible="False"
                                        Visibility="Collapsed" />
                                </Grid>
                            </StackPanel>
                        </StackPanel>

                        <!-- Side menu: two pills. "Auto-hide" (the default) shows the menu at the left edge; "Always visible" keeps it open. Applies at once. -->
                        <StackPanel Spacing="8">
                            <TextBlock x:Uid="Settings/Appearance/NavPaneHeader" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                            <TextBlock
                                x:Uid="Settings/Appearance/NavPaneHint"
                                TextWrapping="Wrap"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button
                                    x:Name="NavAutoHideButton"
                                    x:Uid="Settings/Appearance/NavAutoHide"
                                    Tag="auto"
                                    Click="NavPane_Click"
                                    Style="{StaticResource PillStyle}" />
                                <Button
                                    x:Name="NavAlwaysButton"
                                    x:Uid="Settings/Appearance/NavAlways"
                                    Tag="always"
                                    Click="NavPane_Click"
                                    Style="{StaticResource PillStyle}" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Account: the numeric folders under UserCache that have an 11 folder. The one chosen here is remembered. -->
                <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="12">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE77B;"
                                FontSize="20"
                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                VerticalAlignment="Top"
                                Margin="0,2,0,0" />
                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock x:Uid="Settings/AccountHeader" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                <TextBlock
                                    x:Uid="Settings/AccountHint"
                                    TextWrapping="Wrap"
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Grid>
                        <controls:SearchablePicker
                            x:Name="AccountPicker"
                            MinWidth="320"
                            MaxWidth="420"
                            HorizontalAlignment="Left"
                            ItemsSource="{x:Bind ViewModel.Accounts, Mode=OneWay}"
                            ItemTemplate="{StaticResource AccountChoiceTemplate}"
                            SelectedItem="{x:Bind ViewModel.SelectedAccount, Mode=OneWay}"
                            SelectedTemplate="{StaticResource AccountChoiceTemplate}"
                            Chosen="AccountPicker_Chosen" />
                    </StackPanel>
                </Border>

                <!-- Black Desert folder: browse, or type a path and save it. A folder without UserCache is refused. -->
                <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="12">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE8B7;"
                                FontSize="20"
                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                VerticalAlignment="Top"
                                Margin="0,2,0,0" />
                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock x:Uid="Settings/FolderHeader" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                <TextBlock
                                    x:Uid="Settings/FolderHint"
                                    TextWrapping="Wrap"
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Grid>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox
                                x:Uid="Settings/FolderBox"
                                Text="{x:Bind ViewModel.DataRootText, Mode=TwoWay}" />
                            <Button Grid.Column="1" x:Uid="Settings/FolderBrowseButton" Click="Browse_Click" />
                            <Button
                                Grid.Column="2"
                                x:Uid="Settings/FolderSaveButton"
                                Click="SaveFolder_Click"
                                Style="{StaticResource AccentButtonStyle}" />
                        </Grid>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Button x:Uid="Settings/SetupButton" Click="Setup_Click" />
                            <TextBlock
                                x:Uid="Settings/SetupHint"
                                FontSize="12"
                                VerticalAlignment="Center"
                                TextWrapping="Wrap"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Language: es or en-US. Takes effect after a restart. -->
                <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="12">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE774;"
                                FontSize="20"
                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                VerticalAlignment="Top"
                                Margin="0,2,0,0" />
                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock x:Uid="Settings/LanguageHeader" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                <TextBlock
                                    x:Uid="Settings/LanguageHint"
                                    TextWrapping="Wrap"
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Grid>
                        <ComboBox
                            x:Name="LanguageBox"
                            x:Uid="Settings/LanguageBox"
                            MinWidth="320"
                            MaxWidth="420"
                            HorizontalAlignment="Left"
                            ItemsSource="{x:Bind ViewModel.Languages, Mode=OneWay}"
                            SelectedItem="{x:Bind ViewModel.SelectedLanguage, Mode=OneWay}"
                            SelectionChanged="LanguageBox_SelectionChanged">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:LanguageChoice">
                                    <TextBlock Text="{x:Bind Name, Mode=OneTime}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                </Border>

                <!-- Updates: the version, the last check, a manual check, the install button (only when a newer release exists),
                     the progress of a download, and the switch for the check at startup. Nothing is installed without the button. -->
                <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="12">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE895;"
                                FontSize="20"
                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                VerticalAlignment="Top"
                                Margin="0,2,0,0" />
                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock x:Uid="Settings/UpdatesHeader" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                <TextBlock
                                    x:Uid="Settings/UpdatesHint"
                                    TextWrapping="Wrap"
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Grid>
                        <StackPanel Spacing="4">
                            <TextBlock Text="{x:Bind Updates.CurrentVersionLine, Mode=OneWay}" />
                            <TextBlock
                                Text="{x:Bind Updates.LastCheckLine, Mode=OneWay}"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Uid="Settings/UpdatesCheckButton" Command="{x:Bind Updates.CheckNowCommand}" />
                            <ProgressRing
                                Width="20"
                                Height="20"
                                IsActive="{x:Bind Updates.IsChecking, Mode=OneWay}"
                                Visibility="{x:Bind Updates.IsChecking, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                            <Button
                                Command="{x:Bind Updates.InstallCommand}"
                                Content="{x:Bind Updates.InstallActionText, Mode=OneWay}"
                                Style="{StaticResource AccentButtonStyle}"
                                Visibility="{x:Bind Updates.HasRelease, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                            <Button
                                x:Uid="Settings/UpdatesCancelButton"
                                Command="{x:Bind Updates.CancelDownloadCommand}"
                                Visibility="{x:Bind Updates.CanCancelDownload, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                        <ProgressBar
                            Maximum="100"
                            Value="{x:Bind Updates.DownloadPercent, Mode=OneWay}"
                            Visibility="{x:Bind Updates.IsDownloading, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock Text="{x:Bind Updates.StatusMessage, Mode=OneWay}" TextWrapping="Wrap" />
                        <TextBlock
                            x:Uid="Settings/UpdatesPortableHint"
                            TextWrapping="Wrap"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Visibility="{x:Bind Updates.IsPortable, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                        <ToggleSwitch
                            x:Uid="Settings/UpdatesStartupToggle"
                            IsOn="{x:Bind Updates.CheckOnStartup, Mode=OneWay}"
                            Toggled="UpdatesStartup_Toggled" />
                    </StackPanel>
                </Border>

                <!-- The reminder before a write to a character. Turn it on again after "Don't show again". -->
                <Border Grid.Row="2" Grid.Column="1" Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="12">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xEA8F;"
                                FontSize="20"
                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                VerticalAlignment="Top"
                                Margin="0,2,0,0" />
                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock x:Uid="Settings/WarningsHeader" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                <TextBlock
                                    x:Uid="Settings/WarningsHint"
                                    TextWrapping="Wrap"
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Grid>
                        <ToggleSwitch
                            x:Uid="Settings/ShowWriteHintToggle"
                            IsOn="{x:Bind ViewModel.ShowWriteHint, Mode=OneWay}"
                            Toggled="ShowWriteHint_Toggled" />
                        <TextBlock
                            x:Uid="Settings/ShowWriteHintHint"
                            TextWrapping="Wrap"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Border>

                <!-- Characters of the active account: the name and class the app shows for each one. Edit and reset are per row. -->
                <Border Grid.Row="3" Grid.ColumnSpan="2" Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="12">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE716;"
                                FontSize="20"
                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                VerticalAlignment="Top"
                                Margin="0,2,0,0" />
                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock x:Uid="Settings/CharactersHeader" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                <TextBlock
                                    x:Uid="Settings/CharactersHint"
                                    TextWrapping="Wrap"
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock
                                    x:Name="CharactersMessageText"
                                    TextWrapping="Wrap"
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Grid>
                        <controls:SearchableList x:Name="CharacterList" />
                    </StackPanel>
                </Border>

                <!-- OCR scan of the character selection screen: reads names and classes, shows them over the game, and saves them. -->
                <Border Grid.Row="4" Grid.ColumnSpan="2" Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="12">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE890;"
                                FontSize="20"
                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                VerticalAlignment="Top"
                                Margin="0,2,0,0" />
                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock x:Uid="Settings/ScanHeader" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                <TextBlock
                                    x:Uid="Settings/ScanHint"
                                    TextWrapping="Wrap"
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Grid>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button
                                x:Uid="Settings/ScanStartButton"
                                Click="ScanStart_Click"
                                IsEnabled="{x:Bind Scan.CanStart, Mode=OneWay}"
                                Style="{StaticResource AccentButtonStyle}" />
                            <Button
                                x:Uid="Settings/ScanFinishButton"
                                Click="ScanFinish_Click"
                                IsEnabled="{x:Bind Scan.CanFinish, Mode=OneWay}" />
                            <Button
                                x:Uid="Settings/ScanCancelButton"
                                Click="ScanCancel_Click"
                                IsEnabled="{x:Bind Scan.CanCancel, Mode=OneWay}" />
                            <TextBlock
                                Text="{x:Bind Scan.CountText, Mode=OneWay}"
                                FontSize="12"
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <TextBlock
                            Text="{x:Bind Scan.PageHint, Mode=OneWay}"
                            FontSize="12"
                            TextWrapping="Wrap"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Visibility="{x:Bind Scan.HasPageHint, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                        <InfoBar
                            IsOpen="{x:Bind Scan.IsMessageOpen, Mode=TwoWay}"
                            Severity="{x:Bind ToInfoBarSeverity(Scan.Severity), Mode=OneWay}"
                            Message="{x:Bind Scan.Message, Mode=OneWay}"
                            IsClosable="True" />
                        <StackPanel
                            Spacing="8"
                            Visibility="{x:Bind Scan.HasReview, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock x:Uid="Settings/ScanReviewHeader" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                            <TextBlock
                                x:Uid="Settings/ScanReviewHint"
                                TextWrapping="Wrap"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <ScrollViewer MaxHeight="420" VerticalScrollBarVisibility="Auto">
                                <ItemsControl
                                    ItemsSource="{x:Bind Scan.Rows, Mode=OneWay}"
                                    ItemTemplate="{StaticResource ScanRowTemplate}" />
                            </ScrollViewer>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button
                                    x:Uid="Settings/ScanSaveButton"
                                    Click="ScanSave_Click"
                                    IsEnabled="{x:Bind Scan.CanSave, Mode=OneWay}"
                                    Style="{StaticResource AccentButtonStyle}" />
                                <Button x:Uid="Settings/ScanDiscardButton" Click="ScanCancel_Click" />
                            </StackPanel>
                        </StackPanel>
                        <Button x:Uid="Settings/ResetCharactersButton" Click="ResetCharacters_Click" />
                    </StackPanel>
                </Border>
            </Grid>

            <InfoBar
                x:Name="StatusBar"
                IsOpen="{x:Bind ViewModel.IsStatusOpen, Mode=TwoWay}"
                Severity="{x:Bind ToInfoBarSeverity(ViewModel.StatusSeverity), Mode=OneWay}"
                Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                IsClosable="True" />
        </StackPanel>
    </ScrollViewer>
</Page>
