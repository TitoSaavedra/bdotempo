<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="BdoComboSetup.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:BdoComboSetup.Core.ViewModels"
    xmlns:combo="using:BdoComboSetup.Core.Combo"
    xmlns:local="using:BdoComboSetup.Views"
    xmlns:controls="using:BdoComboSetup.Views.Controls"
    xmlns:mux="using:Microsoft.UI.Xaml.Controls"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.Resources>
        <!-- Compact controls on this page: buttons and combo boxes are about 30 pixels high, with 13-pixel text. -->
        <Style TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style TargetType="ComboBox" BasedOn="{StaticResource DefaultComboBoxStyle}">
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="FontSize" Value="13" />
        </Style>

        <!-- A round accent swatch. The fill of each swatch is set in code-behind (the page's accent palette, per theme). -->
        <!-- Transparent background so the hover state does not repaint the color. -->
        <Style x:Key="AccentSwatchStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="CornerRadius" Value="13" />
            <!-- A Button defaults to the left of its cell; the swatch must sit in the middle of the ring cell. -->
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- One account of the data folder: its label ("Cuenta 100000001"). -->
        <DataTemplate x:Key="AccountChoiceTemplate" x:DataType="vm:AccountChoice">
            <TextBlock Text="{x:Bind Label, Mode=OneTime}" VerticalAlignment="Center" />
        </DataTemplate>

        <!-- Small icon-only buttons on a character card (the edit pencil and the more menu). -->
        <Style x:Key="CharacterIconButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="FontSize" Value="13" />
        </Style>

        <!-- One character of the active account, as a card in the grid: class icon, name, class, the edit button and the
             more menu that holds Reset. The item is the button's Tag, so the handlers get the character itself. -->
        <DataTemplate x:Key="CharacterCardTemplate" x:DataType="combo:CharacterOption">
            <Border
                Background="{ThemeResource ControlFillColorSecondaryBrush}"
                BorderBrush="{ThemeResource GlassLineBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="10,8"
                Opacity="{x:Bind local:ApplyComboPage.CharacterOpacityOf(HasGameData), Mode=OneTime}">
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <controls:AssetIcon Monochrome="True"
                        Width="40"
                        Height="40"
                        IconSource="{x:Bind local:ApplyComboPage.ClassIconOf(ClassType), Mode=OneTime}"
                        Glyph="{x:Bind local:ApplyComboPage.ClassGlyphOf(ClassType), Mode=OneTime}" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="{x:Bind Name, Mode=OneTime}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            Text="{x:Bind local:SettingsPage.ClassNameOf(ClassType), Mode=OneTime}"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <!-- Shown only while the game has not written the character's file; the tooltip says what to do. -->
                        <TextBlock
                            x:Uid="Settings/CharacterNoDataBadge"
                            FontSize="11"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Visibility="{x:Bind local:SettingsPage.NoGameDataVisibilityOf(HasGameData), Mode=OneTime}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                        <Button
                            x:Uid="Settings/EditCharacterButton"
                            Tag="{x:Bind}"
                            Click="EditCharacter_Click"
                            Style="{StaticResource CharacterIconButtonStyle}">
                            <FontIcon Glyph="&#xE70F;" FontSize="14" />
                        </Button>
                        <Button x:Uid="Settings/CharacterMoreButton" Style="{StaticResource CharacterIconButtonStyle}">
                            <Button.Flyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem
                                        x:Uid="Settings/ResetCharacterMenuItem"
                                        Tag="{x:Bind}"
                                        Click="ResetCharacter_Click" />
                                </MenuFlyout>
                            </Button.Flyout>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- One class of the edit flyout's picker: its icon and its name. -->
        <DataTemplate x:Key="ClassChoiceTemplate" x:DataType="vm:ClassChoice">
            <StackPanel Orientation="Horizontal" Spacing="10" Padding="2">
                <controls:AssetIcon Monochrome="True" Width="24" Height="24" IconSource="{x:Bind OpenIcon, Mode=OneTime}" />
                <TextBlock Text="{x:Bind Name, Mode=OneTime}" VerticalAlignment="Center" />
            </StackPanel>
        </DataTemplate>

        <!-- One row of the OCR review: the name (editable), the level read, and the class (editable). -->
        <!-- One row of the OCR review, two lines so it fits the narrow scan card: the order, the name (editable) and the level
             read; then the class (a searchable picker) and the memo and previous name underneath. -->
        <DataTemplate x:Key="ScanRowTemplate" x:DataType="vm:CharacterScanRow">
            <Grid ColumnSpacing="8" RowSpacing="4" Padding="4,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock
                    Text="{x:Bind Order, Mode=OneTime}"
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    VerticalAlignment="Center" />
                <TextBox Grid.Column="1" Text="{x:Bind Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MaxLength="40" />
                <TextBlock
                    Grid.Column="2"
                    Text="{x:Bind LevelText, Mode=OneTime}"
                    FontSize="12"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <controls:SearchablePicker
                    Grid.Row="1"
                    Grid.Column="1"
                    Grid.ColumnSpan="2"
                    HorizontalAlignment="Stretch"
                    Tag="{x:Bind}"
                    ItemsSource="{x:Bind Classes, Mode=OneTime}"
                    ItemTemplate="{StaticResource ClassChoiceTemplate}"
                    SelectedItem="{x:Bind Class, Mode=OneWay}"
                    SelectedTemplate="{StaticResource ClassChoiceTemplate}"
                    FieldsOf="{x:Bind local:SettingsPage.ClassChoiceFields, Mode=OneTime}"
                    Chosen="ScanClassPicker_Chosen" />
                <StackPanel Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Spacing="2">
                    <TextBlock
                        Text="{x:Bind MemoText, Mode=OneTime}"
                        FontSize="11"
                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                        Visibility="{x:Bind HasMemo, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock
                        Text="{x:Bind PreviousText, Mode=OneTime}"
                        FontSize="11"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Visibility="{x:Bind HasPreviousName, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <!-- Rows: the heading and the tabs (fixed), the tab content (fills the height), the status line (fixed). The General tab
         scrolls inside its own ScrollViewer; the Characters tab fits the window height. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- The page has no heading: Settings is shown from the gear of the title bar. -->
        <StackPanel Padding="12,4,12,0" Spacing="8">

            <!-- Changes that only take effect after a restart (language, data folder, Preview account). -->
            <InfoBar
                x:Uid="Settings/RestartBar"
                IsOpen="{x:Bind ViewModel.RestartRequired, Mode=OneWay}"
                Severity="Warning"
                IsClosable="False">
                <InfoBar.ActionButton>
                    <Button x:Uid="Settings/RestartButton" Click="Restart_Click" />
                </InfoBar.ActionButton>
            </InfoBar>

            <!-- The two tabs: General (the settings) and Characters (the account's characters and the OCR scan). -->
            <SelectorBar Margin="-12,0,0,0" SelectionChanged="SettingsTabs_SelectionChanged">
                <SelectorBarItem x:Uid="Settings/TabGeneral" Tag="general" IsSelected="True" />
                <SelectorBarItem x:Uid="Settings/TabCharacters" Tag="characters" />
            </SelectorBar>
        </StackPanel>

        <!-- General: two sections of cards, Aplicación and Juego (with Actualizaciones under it). Two columns when the window
             is wide, one column when it is narrow. Each card keeps its natural height. The tab scrolls inside this ScrollViewer. -->
        <ScrollViewer
            x:Name="GeneralScroll"
            Grid.Row="1"
            Padding="12,8,12,12"
            VerticalScrollBarVisibility="Auto">
            <Grid
                x:Name="GeneralLayout"
                ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroup>
                        <VisualState x:Name="WideGeneralLayout">
                            <VisualState.StateTriggers>
                                <AdaptiveTrigger MinWindowWidth="960" />
                            </VisualState.StateTriggers>
                            <VisualState.Setters>
                                <Setter Target="ApplicationColumn.(Grid.Row)" Value="0" />
                                <Setter Target="ApplicationColumn.(Grid.Column)" Value="0" />
                                <Setter Target="ApplicationColumn.(Grid.ColumnSpan)" Value="1" />
                                <Setter Target="GameColumn.(Grid.Row)" Value="0" />
                                <Setter Target="GameColumn.(Grid.Column)" Value="1" />
                                <Setter Target="GameColumn.(Grid.ColumnSpan)" Value="1" />
                                <Setter Target="GameColumn.Margin" Value="0" />
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState x:Name="NarrowGeneralLayout">
                            <VisualState.StateTriggers>
                                <AdaptiveTrigger MinWindowWidth="0" />
                            </VisualState.StateTriggers>
                            <VisualState.Setters>
                                <Setter Target="ApplicationColumn.(Grid.Row)" Value="0" />
                                <Setter Target="ApplicationColumn.(Grid.Column)" Value="0" />
                                <Setter Target="ApplicationColumn.(Grid.ColumnSpan)" Value="2" />
                                <Setter Target="GameColumn.(Grid.Row)" Value="1" />
                                <Setter Target="GameColumn.(Grid.Column)" Value="0" />
                                <Setter Target="GameColumn.(Grid.ColumnSpan)" Value="2" />
                                <Setter Target="GameColumn.Margin" Value="0,12,0,0" />
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateManager.VisualStateGroups>

                <!-- Aplicación: how the app looks and speaks, and the write reminder. -->
                <StackPanel x:Name="ApplicationColumn" Grid.Row="0" Grid.Column="0" Spacing="12">
                    <TextBlock
                        x:Uid="Settings/SectionAppHeader"
                        Style="{ThemeResource BodyStrongTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                    <!-- Appearance: the theme (follows Windows or fixed), the accent color and the skill tooltips. Applies at once. -->
                    <Border Style="{StaticResource CardBorderStyle}">
                        <StackPanel Spacing="8">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xE790;"
                                    FontSize="18"
                                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                    VerticalAlignment="Top"
                                    Margin="0,2,0,0" />
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock x:Uid="Settings/Appearance/Header" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                </StackPanel>
                            </Grid>

                            <!-- Theme: three pills. The selected one is filled with the accent (set in code-behind). -->
                            <Grid MinHeight="32" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Uid="Settings/Appearance/ThemeHeader" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <Button
                                        x:Name="ThemeSystemButton"
                                        x:Uid="Settings/Appearance/ThemeSystem"
                                        Tag="system"
                                        Click="Theme_Click"
                                        Style="{StaticResource PillStyle}" />
                                    <Button
                                        x:Name="ThemeLightButton"
                                        x:Uid="Settings/Appearance/ThemeLight"
                                        Tag="light"
                                        Click="Theme_Click"
                                        Style="{StaticResource PillStyle}" />
                                    <Button
                                        x:Name="ThemeDarkButton"
                                        x:Uid="Settings/Appearance/ThemeDark"
                                        Tag="dark"
                                        Click="Theme_Click"
                                        Style="{StaticResource PillStyle}" />
                                </StackPanel>
                            </Grid>

                            <!-- Accent color: the name of the chosen accent beside its label; five swatches, the chosen one has a ring. -->
                            <Grid MinHeight="32" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <TextBlock x:Uid="Settings/Appearance/AccentHeader" VerticalAlignment="Center" />
                                    <TextBlock
                                        Text="{x:Bind local:SettingsPage.AccentNameOf(ViewModel.AccentColor), Mode=OneWay}"
                                        VerticalAlignment="Center"
                                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Grid Width="32" Height="32">
                                        <Button x:Uid="Settings/Appearance/SwatchViolet" Tag="violet" Click="Accent_Click" Style="{StaticResource AccentSwatchStyle}">
                                            <Ellipse x:Name="SwatchFillViolet" Width="26" Height="26" />
                                        </Button>
                                        <Border
                                            x:Name="AccentRingViolet"
                                            Width="32"
                                            Height="32"
                                            CornerRadius="16"
                                            BorderThickness="2"
                                            BorderBrush="{ThemeResource TextFillColorPrimaryBrush}"
                                            IsHitTestVisible="False"
                                            Visibility="Collapsed" />
                                    </Grid>
                                    <Grid Width="32" Height="32">
                                        <Button x:Uid="Settings/Appearance/SwatchAmber" Tag="amber" Click="Accent_Click" Style="{StaticResource AccentSwatchStyle}">
                                            <Ellipse x:Name="SwatchFillAmber" Width="26" Height="26" />
                                        </Button>
                                        <Border
                                            x:Name="AccentRingAmber"
                                            Width="32"
                                            Height="32"
                                            CornerRadius="16"
                                            BorderThickness="2"
                                            BorderBrush="{ThemeResource TextFillColorPrimaryBrush}"
                                            IsHitTestVisible="False"
                                            Visibility="Collapsed" />
                                    </Grid>
                                    <Grid Width="32" Height="32">
                                        <Button x:Uid="Settings/Appearance/SwatchMint" Tag="mint" Click="Accent_Click" Style="{StaticResource AccentSwatchStyle}">
                                            <Ellipse x:Name="SwatchFillMint" Width="26" Height="26" />
                                        </Button>
                                        <Border
                                            x:Name="AccentRingMint"
                                            Width="32"
                                            Height="32"
                                            CornerRadius="16"
                                            BorderThickness="2"
                                            BorderBrush="{ThemeResource TextFillColorPrimaryBrush}"
                                            IsHitTestVisible="False"
                                            Visibility="Collapsed" />
                                    </Grid>
                                    <Grid Width="32" Height="32">
                                        <Button x:Uid="Settings/Appearance/SwatchRose" Tag="rose" Click="Accent_Click" Style="{StaticResource AccentSwatchStyle}">
                                            <Ellipse x:Name="SwatchFillRose" Width="26" Height="26" />
                                        </Button>
                                        <Border
                                            x:Name="AccentRingRose"
                                            Width="32"
                                            Height="32"
                                            CornerRadius="16"
                                            BorderThickness="2"
                                            BorderBrush="{ThemeResource TextFillColorPrimaryBrush}"
                                            IsHitTestVisible="False"
                                            Visibility="Collapsed" />
                                    </Grid>
                                    <Grid Width="32" Height="32">
                                        <Button x:Uid="Settings/Appearance/SwatchBlue" Tag="blue" Click="Accent_Click" Style="{StaticResource AccentSwatchStyle}">
                                            <Ellipse x:Name="SwatchFillBlue" Width="26" Height="26" />
                                        </Button>
                                        <Border
                                            x:Name="AccentRingBlue"
                                            Width="32"
                                            Height="32"
                                            CornerRadius="16"
                                            BorderThickness="2"
                                            BorderBrush="{ThemeResource TextFillColorPrimaryBrush}"
                                            IsHitTestVisible="False"
                                            Visibility="Collapsed" />
                                    </Grid>
                                </StackPanel>
                            </Grid>

                            <!-- Skill tooltips: hovering a skill shows its icon, cost, cooldown and damage. Applies at once. -->
                            <Grid MinHeight="32" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Uid="Settings/Appearance/SkillTooltipsLabel" VerticalAlignment="Center" />
                                <ToggleSwitch
                                    Grid.Column="1"
                                    x:Uid="Settings/Appearance/SkillTooltipsToggle"
                                    VerticalAlignment="Center"
                                    IsOn="{x:Bind ViewModel.ShowSkillTooltips, Mode=OneWay}"
                                    Toggled="SkillTooltipsToggle_Toggled" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Language: es or en-US. Takes effect after a restart. -->
                    <Border Style="{StaticResource CardBorderStyle}">
                        <StackPanel Spacing="8">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xE774;"
                                    FontSize="18"
                                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                    VerticalAlignment="Top"
                                    Margin="0,2,0,0" />
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock x:Uid="Settings/LanguageHeader" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                </StackPanel>
                            </Grid>
                            <Grid MinHeight="32" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Uid="Settings/LanguageLabel" VerticalAlignment="Center" />
                                <ComboBox
                                    Grid.Column="1"
                                    x:Name="LanguageBox"
                                    x:Uid="Settings/LanguageBox"
                                    MinWidth="200"
                                    VerticalAlignment="Center"
                                    ItemsSource="{x:Bind ViewModel.Languages, Mode=OneWay}"
                                    SelectedItem="{x:Bind ViewModel.SelectedLanguage, Mode=OneWay}"
                                    SelectionChanged="LanguageBox_SelectionChanged">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:LanguageChoice">
                                            <TextBlock Text="{x:Bind Name, Mode=OneTime}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Avisos: the reminder before a write to a character. Turn it on again after "Don't show again". -->
                    <Border Style="{StaticResource CardBorderStyle}">
                        <StackPanel Spacing="8">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xEA8F;"
                                    FontSize="18"
                                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                    VerticalAlignment="Top"
                                    Margin="0,2,0,0" />
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock x:Uid="Settings/WarningsHeader" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                </StackPanel>
                            </Grid>
                            <Grid MinHeight="32" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Uid="Settings/ShowWriteHintLabel" VerticalAlignment="Center" />
                                <ToggleSwitch
                                    Grid.Column="1"
                                    x:Uid="Settings/ShowWriteHintToggle"
                                    VerticalAlignment="Center"
                                    IsOn="{x:Bind ViewModel.ShowWriteHint, Mode=OneWay}"
                                    Toggled="ShowWriteHint_Toggled" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Juego: the game folder, the account and the initial setup; then Actualizaciones. -->
                <StackPanel x:Name="GameColumn" Grid.Row="0" Grid.Column="1" Spacing="12">
                    <TextBlock
                        x:Uid="Settings/SectionGameHeader"
                        Style="{ThemeResource BodyStrongTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                    <!-- Game: the Black Desert folder (browse, or type a path and save it; a folder without UserCache is refused),
                         the account (the numeric folders under UserCache that have an 11 folder; the one chosen is remembered) and
                         the initial setup. -->
                    <Border Style="{StaticResource CardBorderStyle}">
                        <StackPanel Spacing="8">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xE8B7;"
                                    FontSize="18"
                                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                    VerticalAlignment="Top"
                                    Margin="0,2,0,0" />
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock x:Uid="Settings/GameCardHeader" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                </StackPanel>
                            </Grid>
                            <Grid MinHeight="32" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Uid="Settings/FolderLabel" VerticalAlignment="Center" />
                                <Grid Grid.Column="1" ColumnSpacing="8" VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox
                                        x:Uid="Settings/FolderBox"
                                        Text="{x:Bind ViewModel.DataRootText, Mode=TwoWay}" />
                                    <Button Grid.Column="1" x:Uid="Settings/FolderBrowseButton" Click="Browse_Click" />
                                    <Button
                                        Grid.Column="2"
                                        x:Uid="Settings/FolderSaveButton"
                                        Click="SaveFolder_Click"
                                        Style="{StaticResource AccentButtonStyle}" />
                                </Grid>
                            </Grid>
                            <Grid MinHeight="32" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Uid="Settings/AccountHeader" VerticalAlignment="Center" />
                                <controls:SearchablePicker
                                    Grid.Column="1"
                                    x:Name="AccountPicker"
                                    Width="260"
                                    VerticalAlignment="Center"
                                    ItemsSource="{x:Bind ViewModel.Accounts, Mode=OneWay}"
                                    ItemTemplate="{StaticResource AccountChoiceTemplate}"
                                    SelectedItem="{x:Bind ViewModel.SelectedAccount, Mode=OneWay}"
                                    SelectedTemplate="{StaticResource AccountChoiceTemplate}"
                                    Chosen="AccountPicker_Chosen" />
                            </Grid>
                            <Grid MinHeight="32" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Uid="Settings/SetupLabel" VerticalAlignment="Center" />
                                <Button
                                    Grid.Column="1"
                                    x:Uid="Settings/SetupButton"
                                    VerticalAlignment="Center"
                                    Click="Setup_Click" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <TextBlock
                        x:Uid="Settings/UpdatesHeader"
                        Style="{ThemeResource BodyStrongTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                    <!-- Updates: the version, the last check and a manual check, the install button (only when a newer release exists),
                         the progress of a download, and the switch for the check at startup. Nothing is installed without the button. -->
                    <Border Style="{StaticResource CardBorderStyle}">
                        <StackPanel Spacing="10">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xE895;"
                                    FontSize="18"
                                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                    VerticalAlignment="Top"
                                    Margin="0,2,0,0" />
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock x:Uid="Settings/UpdatesCardHeader" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                </StackPanel>
                            </Grid>
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Text="{x:Bind Updates.CurrentVersionLine, Mode=OneWay}"
                                    VerticalAlignment="Center"
                                    TextWrapping="Wrap" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Button x:Uid="Settings/UpdatesCheckButton" Command="{x:Bind Updates.CheckNowCommand}" />
                                    <ProgressRing
                                        Width="20"
                                        Height="20"
                                        IsActive="{x:Bind Updates.IsChecking, Mode=OneWay}"
                                        Visibility="{x:Bind Updates.IsChecking, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                                </StackPanel>
                            </Grid>
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Text="{x:Bind Updates.LastCheckLine, Mode=OneWay}"
                                    VerticalAlignment="Center"
                                    FontSize="12"
                                    TextWrapping="Wrap"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Button
                                        Command="{x:Bind Updates.InstallCommand}"
                                        Content="{x:Bind Updates.InstallActionText, Mode=OneWay}"
                                        Style="{StaticResource AccentButtonStyle}"
                                        Visibility="{x:Bind Updates.HasRelease, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                                    <Button
                                        x:Uid="Settings/UpdatesCancelButton"
                                        Command="{x:Bind Updates.CancelDownloadCommand}"
                                        Visibility="{x:Bind Updates.CanCancelDownload, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                                </StackPanel>
                            </Grid>
                            <ProgressBar
                                Maximum="100"
                                Value="{x:Bind Updates.DownloadPercent, Mode=OneWay}"
                                Visibility="{x:Bind Updates.IsDownloading, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                            <TextBlock
                                Text="{x:Bind Updates.StatusMessage, Mode=OneWay}"
                                TextWrapping="Wrap"
                                Visibility="{x:Bind local:SettingsPage.VisibilityOfText(Updates.StatusMessage), Mode=OneWay}" />
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Uid="Settings/UpdatesStartupLabel" VerticalAlignment="Center" />
                                <ToggleSwitch
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    IsOn="{x:Bind Updates.CheckOnStartup, Mode=OneWay}"
                                    Toggled="UpdatesStartup_Toggled" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- Characters: the account's characters as a grid of cards (left) and the OCR scan card (right). The scan card
             moves under the list when the window is narrow. The list scrolls inside its own card; the tab fills the height. -->
        <Grid
            x:Name="TabCharacters"
            Grid.Row="1"
            Margin="24,10,24,16"
            ColumnSpacing="10"
            RowSpacing="10"
            Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="320" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup>
                    <VisualState x:Name="WideCharactersLayout">
                        <VisualState.StateTriggers>
                            <AdaptiveTrigger MinWindowWidth="960" />
                        </VisualState.StateTriggers>
                        <VisualState.Setters>
                            <Setter Target="CharactersCard.(Grid.Row)" Value="0" />
                            <Setter Target="CharactersCard.(Grid.Column)" Value="0" />
                            <Setter Target="CharactersCard.(Grid.ColumnSpan)" Value="1" />
                            <Setter Target="ScanCard.(Grid.Row)" Value="0" />
                            <Setter Target="ScanCard.(Grid.Column)" Value="1" />
                            <Setter Target="ScanCard.(Grid.ColumnSpan)" Value="1" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="NarrowCharactersLayout">
                        <VisualState.StateTriggers>
                            <AdaptiveTrigger MinWindowWidth="0" />
                        </VisualState.StateTriggers>
                        <VisualState.Setters>
                            <Setter Target="CharactersCard.(Grid.Row)" Value="0" />
                            <Setter Target="CharactersCard.(Grid.Column)" Value="0" />
                            <Setter Target="CharactersCard.(Grid.ColumnSpan)" Value="2" />
                            <Setter Target="ScanCard.(Grid.Row)" Value="1" />
                            <Setter Target="ScanCard.(Grid.Column)" Value="0" />
                            <Setter Target="ScanCard.(Grid.ColumnSpan)" Value="2" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>

            <!-- The account's characters: the name and class the app shows for each one. Edit and reset are per card. -->
            <Border x:Name="CharactersCard" Grid.Row="0" Grid.Column="0" Style="{StaticResource CardBorderStyle}">
                <Grid RowSpacing="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE716;"
                            FontSize="18"
                            Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                            VerticalAlignment="Top"
                            Margin="0,2,0,0" />
                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock x:Uid="Settings/CharactersHeader" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                            <TextBlock
                                x:Name="CharactersCountText"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock
                                x:Name="CharactersMessageText"
                                TextWrapping="Wrap"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Visibility="Collapsed" />
                        </StackPanel>
                        <Button
                            Grid.Column="2"
                            x:Uid="Settings/ResetCharactersButton"
                            VerticalAlignment="Top"
                            Click="ResetCharacters_Click" />
                    </Grid>
                    <TextBox
                        Grid.Row="1"
                        x:Name="CharacterSearchBox"
                        x:Uid="Settings/CharactersSearchBox"
                        TextChanged="CharacterSearchBox_TextChanged" />
                    <Grid Grid.Row="2" RowSpacing="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <mux:ItemsRepeater x:Name="CharacterGrid" ItemTemplate="{StaticResource CharacterCardTemplate}">
                                <mux:ItemsRepeater.Layout>
                                    <mux:UniformGridLayout
                                        MinItemWidth="240"
                                        MinRowSpacing="10"
                                        MinColumnSpacing="10"
                                        ItemsStretch="Fill" />
                                </mux:ItemsRepeater.Layout>
                            </mux:ItemsRepeater>
                        </ScrollViewer>
                        <TextBlock
                            x:Name="CharactersEmptyText"
                            Grid.Row="1"
                            x:Uid="SearchableList/Empty"
                            Visibility="Collapsed"
                            TextWrapping="Wrap"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Grid>
                </Grid>
            </Border>

            <!-- OCR scan of the character selection screen: reads names and classes, shows them over the game, and saves them. -->
            <Border x:Name="ScanCard" Grid.Row="0" Grid.Column="1" Style="{StaticResource CardBorderStyle}">
                <Grid RowSpacing="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Spacing="8">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE890;"
                                FontSize="18"
                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                VerticalAlignment="Top"
                                Margin="0,2,0,0" />
                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock x:Uid="Settings/ScanHeader" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                            </StackPanel>
                        </Grid>
                        <Button
                            x:Uid="Settings/ScanStartButton"
                            HorizontalAlignment="Stretch"
                            Click="ScanStart_Click"
                            IsEnabled="{x:Bind Scan.CanStart, Mode=OneWay}"
                            Style="{StaticResource AccentButtonStyle}" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button
                                Grid.Column="0"
                                x:Uid="Settings/ScanFinishButton"
                                HorizontalAlignment="Stretch"
                                Click="ScanFinish_Click"
                                IsEnabled="{x:Bind Scan.CanFinish, Mode=OneWay}" />
                            <Button
                                Grid.Column="1"
                                x:Uid="Settings/ScanCancelButton"
                                HorizontalAlignment="Stretch"
                                Click="ScanCancel_Click"
                                IsEnabled="{x:Bind Scan.CanCancel, Mode=OneWay}" />
                        </Grid>
                        <TextBlock
                            Text="{x:Bind Scan.CountText, Mode=OneWay}"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock
                            Text="{x:Bind Scan.PageHint, Mode=OneWay}"
                            FontSize="12"
                            TextWrapping="Wrap"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Visibility="{x:Bind Scan.HasPageHint, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                        <InfoBar
                            IsOpen="{x:Bind Scan.IsMessageOpen, Mode=TwoWay}"
                            Severity="{x:Bind ToInfoBarSeverity(Scan.Severity), Mode=OneWay}"
                            Message="{x:Bind Scan.Message, Mode=OneWay}"
                            IsClosable="True" />
                    </StackPanel>
                    <Grid
                        Grid.Row="1"
                        RowSpacing="8"
                        Visibility="{x:Bind Scan.HasReview, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock x:Uid="Settings/ScanReviewHeader" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                        <ScrollViewer Grid.Row="1" MaxHeight="420" VerticalScrollBarVisibility="Auto">
                            <ItemsControl
                                ItemsSource="{x:Bind Scan.Rows, Mode=OneWay}"
                                ItemTemplate="{StaticResource ScanRowTemplate}" />
                        </ScrollViewer>
                        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8">
                            <Button
                                x:Uid="Settings/ScanSaveButton"
                                Click="ScanSave_Click"
                                IsEnabled="{x:Bind Scan.CanSave, Mode=OneWay}"
                                Style="{StaticResource AccentButtonStyle}" />
                            <Button x:Uid="Settings/ScanDiscardButton" Click="ScanCancel_Click" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <InfoBar
            x:Name="StatusBar"
            Grid.Row="2"
            Margin="24,0,24,16"
            IsOpen="{x:Bind ViewModel.IsStatusOpen, Mode=TwoWay}"
            Severity="{x:Bind ToInfoBarSeverity(ViewModel.StatusSeverity), Mode=OneWay}"
            Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
            IsClosable="True" />
    </Grid>
</Page>
