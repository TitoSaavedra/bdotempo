<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="BdoComboSetup.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:BdoComboSetup.Core.ViewModels"
    xmlns:combo="using:BdoComboSetup.Core.Combo"
    xmlns:local="using:BdoComboSetup.Views"
    xmlns:controls="using:BdoComboSetup.Views.Controls"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.Resources>
        <!-- One account of the data folder: its label ("Account 100000001"). -->
        <DataTemplate x:Key="AccountChoiceTemplate" x:DataType="vm:AccountChoice">
            <TextBlock Text="{x:Bind Label, Mode=OneTime}" VerticalAlignment="Center" />
        </DataTemplate>

        <!-- One character of the active account: class icon, name, class, and the per-row Edit and Reset actions. -->
        <DataTemplate x:Key="CharacterRowTemplate" x:DataType="combo:CharacterOption">
            <Grid ColumnSpacing="10" Padding="4,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <controls:AssetIcon
                    Width="28"
                    Height="28"
                    IconSource="{x:Bind local:ApplyComboPage.ClassIconOf(ClassType), Mode=OneTime}"
                    Glyph="{x:Bind local:ApplyComboPage.ClassGlyphOf(ClassType), Mode=OneTime}" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                    <TextBlock Text="{x:Bind Name, Mode=OneTime}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        Text="{x:Bind local:SettingsPage.ClassNameOf(ClassType), Mode=OneTime}"
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <Button Grid.Column="2" x:Uid="Settings/EditCharacterButton" VerticalAlignment="Center" Click="EditCharacter_Click" />
                <Button Grid.Column="3" x:Uid="Settings/ResetCharacterButton" VerticalAlignment="Center" Click="ResetCharacter_Click" />
            </Grid>
        </DataTemplate>

        <!-- One class of the edit flyout's picker: its icon and its name. -->
        <DataTemplate x:Key="ClassChoiceTemplate" x:DataType="vm:ClassChoice">
            <StackPanel Orientation="Horizontal" Spacing="10" Padding="2">
                <controls:AssetIcon Width="24" Height="24" IconSource="{x:Bind OpenIcon, Mode=OneTime}" />
                <TextBlock Text="{x:Bind Name, Mode=OneTime}" VerticalAlignment="Center" />
            </StackPanel>
        </DataTemplate>
    </Page.Resources>

    <ScrollViewer Padding="24,16,24,16" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="22" MaxWidth="720" HorizontalAlignment="Left">
            <TextBlock x:Uid="Settings/Title" Style="{ThemeResource TitleTextBlockStyle}" />

            <!-- Changes that only take effect after a restart (language, data folder, Preview account). -->
            <InfoBar
                x:Uid="Settings/RestartBar"
                IsOpen="{x:Bind ViewModel.RestartRequired, Mode=OneWay}"
                Severity="Warning"
                IsClosable="False">
                <InfoBar.ActionButton>
                    <Button x:Uid="Settings/RestartButton" Click="Restart_Click" />
                </InfoBar.ActionButton>
            </InfoBar>

            <!-- Account: the numeric folders under UserCache that have an 11 folder. The one chosen here is remembered. -->
            <StackPanel Spacing="6">
                <TextBlock x:Uid="Settings/AccountHeader" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                <TextBlock
                    x:Uid="Settings/AccountHint"
                    TextWrapping="Wrap"
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <controls:SearchablePicker
                    x:Name="AccountPicker"
                    MinWidth="320"
                    HorizontalAlignment="Left"
                    ItemsSource="{x:Bind ViewModel.Accounts, Mode=OneWay}"
                    ItemTemplate="{StaticResource AccountChoiceTemplate}"
                    SelectedItem="{x:Bind ViewModel.SelectedAccount, Mode=OneWay}"
                    SelectedTemplate="{StaticResource AccountChoiceTemplate}"
                    Chosen="AccountPicker_Chosen" />
            </StackPanel>

            <!-- Characters of the active account: the name and class the app shows for each one. Edit and reset are per row. -->
            <StackPanel Spacing="6">
                <TextBlock x:Uid="Settings/CharactersHeader" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                <TextBlock
                    x:Uid="Settings/CharactersHint"
                    TextWrapping="Wrap"
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock
                    x:Name="CharactersMessageText"
                    TextWrapping="Wrap"
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <controls:SearchableList x:Name="CharacterList" />
            </StackPanel>

            <!-- Black Desert folder: browse, or type a path and save it. A folder without UserCache is refused. -->
            <StackPanel Spacing="6">
                <TextBlock x:Uid="Settings/FolderHeader" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                <TextBlock
                    x:Uid="Settings/FolderHint"
                    TextWrapping="Wrap"
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox
                        x:Uid="Settings/FolderBox"
                        Text="{x:Bind ViewModel.DataRootText, Mode=TwoWay}" />
                    <Button Grid.Column="1" x:Uid="Settings/FolderBrowseButton" Click="Browse_Click" />
                    <Button
                        Grid.Column="2"
                        x:Uid="Settings/FolderSaveButton"
                        Click="SaveFolder_Click"
                        Style="{StaticResource AccentButtonStyle}" />
                </Grid>
            </StackPanel>

            <!-- Language: es or en-US. Takes effect after a restart. -->
            <StackPanel Spacing="6">
                <TextBlock x:Uid="Settings/LanguageHeader" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                <ComboBox
                    x:Name="LanguageBox"
                    x:Uid="Settings/LanguageBox"
                    MinWidth="320"
                    ItemsSource="{x:Bind ViewModel.Languages, Mode=OneWay}"
                    SelectedItem="{x:Bind ViewModel.SelectedLanguage, Mode=OneWay}"
                    SelectionChanged="LanguageBox_SelectionChanged">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:LanguageChoice">
                            <TextBlock Text="{x:Bind Name, Mode=OneTime}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>

            <!-- The reminder before a write to a character. Turn it on again after "Don't show again". -->
            <StackPanel Spacing="6">
                <ToggleSwitch
                    x:Uid="Settings/ShowWriteHintToggle"
                    IsOn="{x:Bind ViewModel.ShowWriteHint, Mode=OneWay}"
                    Toggled="ShowWriteHint_Toggled" />
                <TextBlock
                    x:Uid="Settings/ShowWriteHintHint"
                    TextWrapping="Wrap"
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <InfoBar
                x:Name="StatusBar"
                IsOpen="{x:Bind ViewModel.IsStatusOpen, Mode=TwoWay}"
                Severity="{x:Bind ToInfoBarSeverity(ViewModel.StatusSeverity), Mode=OneWay}"
                Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                IsClosable="True" />
        </StackPanel>
    </ScrollViewer>
</Page>
