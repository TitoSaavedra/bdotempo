<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="BdoComboSetup.Views.PreviewPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:BdoComboSetup.Views"
    xmlns:controls="using:BdoComboSetup.Views.Controls"
    xmlns:combo="using:BdoComboSetup.Core.Combo"
    xmlns:vm="using:BdoComboSetup.Core.ViewModels"
    >

    <Page.Resources>
        <!-- One section of the page: a card with the app's surface colors. -->
        <Style x:Key="EditorCard" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="14" />
        </Style>

        <!-- A glass card of the sidebar: state, settings and character. -->
        <Style x:Key="SideCardStyle" TargetType="Border" BasedOn="{StaticResource GlassCardStyle}">
            <Setter Property="Padding" Value="14" />
        </Style>

        <!-- The character shown in the sidebar: class icon and name only. -->
        <DataTemplate x:Key="SelectedCharacterTemplate" x:DataType="combo:CharacterOption">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <controls:AssetIcon
                    Monochrome="True"
                    Width="32"
                    Height="32"
                    IconSource="{x:Bind local:ApplyComboPage.ClassIconOf(ClassType), Mode=OneTime}"
                    Glyph="{x:Bind local:ApplyComboPage.ClassGlyphOf(ClassType), Mode=OneTime}" />
                <TextBlock Text="{x:Bind Name, Mode=OneTime}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </DataTemplate>

        <!-- A skill that no slot holds: drag it to a slot, or tap + for the first free slot. -->
        <DataTemplate x:Key="PendingSkillTemplate" x:DataType="vm:PendingSkill">
            <Grid
                Margin="0,0,0,5"
                Padding="6,5"
                ColumnSpacing="8"
                CornerRadius="8"
                Background="{ThemeResource GlassChipBrush}"
                CanDrag="True"
                DragStarting="PendingSkill_DragStarting"
                DropCompleted="PendingSkill_DropCompleted">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <controls:AssetIcon
                    Width="28"
                    Height="28"
                    IconSource="{x:Bind OpenIcon, Mode=OneTime}"
                    Glyph="{x:Bind Glyph, Mode=OneTime}" />
                <TextBlock
                    Grid.Column="1"
                    Text="{x:Bind Name, Mode=OneTime}"
                    FontSize="13"
                    VerticalAlignment="Center"
                    TextTrimming="CharacterEllipsis" />
                <Button
                    Grid.Column="2"
                    Content="+"
                    Padding="10,2"
                    MinHeight="0"
                    MinWidth="0"
                    Click="PendingAdd_Click" />
            </Grid>
        </DataTemplate>

        <!-- One group of pending skills: its title and count, then its skills. -->
        <DataTemplate x:Key="PendingGroupTemplate" x:DataType="vm:PendingGroup">
            <StackPanel Margin="0,10,0,0" Spacing="4">
                <Grid>
                    <TextBlock Text="{x:Bind Title, Mode=OneTime}" FontSize="11" CharacterSpacing="60" Opacity="0.75" />
                    <TextBlock Text="{x:Bind CountText, Mode=OneTime}" FontSize="11" HorizontalAlignment="Right" Opacity="0.75" />
                </Grid>
                <ItemsControl ItemsSource="{x:Bind Items, Mode=OneTime}" ItemTemplate="{StaticResource PendingSkillTemplate}" />
            </StackPanel>
        </DataTemplate>

    </Page.Resources>

    <Grid Padding="24,16" ColumnSpacing="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="280" />
        </Grid.ColumnDefinitions>

        <!-- The game and what is drawn on it: the header, the review, the live surface, the legend and the status. -->
        <Grid RowSpacing="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header: the combo in the editor. -->
            <StackPanel Grid.Row="0" Spacing="2">
                <TextBlock x:Uid="Preview/Title" Style="{ThemeResource TitleTextBlockStyle}" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock
                        Text="{x:Bind Apply.ClassName, Mode=OneWay}"
                        Style="{ThemeResource SubtitleTextBlockStyle}"
                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                    <TextBlock
                        Text="{x:Bind Apply.Editor.Title, Mode=OneWay}"
                        FontSize="13"
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>

            </StackPanel>

            <!-- The review of the character file: opened by "Apply to character" with the chosen parts. -->
            <Border
                Grid.Row="1"
                Style="{StaticResource EditorCard}"
                BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                Visibility="{x:Bind Apply.IsReviewOpen, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                <StackPanel Spacing="8">
                    <TextBlock x:Uid="Apply/ReviewTitle" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                    <TextBlock Text="{x:Bind Apply.ReviewSummary, Mode=OneWay}" />
                    <ListView
                        ItemsSource="{x:Bind Apply.ReviewLines, Mode=OneWay}"
                        SelectionMode="None"
                        MaxHeight="140" />
                    <TextBlock
                        x:Uid="Apply/ReviewBackupNote"
                        FontSize="12"
                        TextWrapping="Wrap"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button
                            x:Uid="Apply/WriteButton"
                            Command="{x:Bind Apply.ConfirmWriteCommand}"
                            Style="{StaticResource AccentButtonStyle}" />
                        <Button x:Uid="Apply/CancelReviewButton" Command="{x:Bind Apply.CancelReviewCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- The live game: a large glass card. The slots are drawn over the capture (black when the game is not visible),
                 and a pill in the corner says what is captured. -->
            <Border
                Grid.Row="2"
                Padding="0"
                Style="{StaticResource PreviewSurfaceStyle}"
                CornerRadius="18"
                >
                <Grid>
                    <local:GameScreenCanvas DataContext="{x:Bind ViewModel}" />

                    <Border
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Margin="14"
                        Padding="12,5"
                        Background="{ThemeResource PreviewOverlayBrush}"
                        BorderBrush="{ThemeResource PreviewOverlayLineBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        IsHitTestVisible="False">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Grid Width="8" Height="8" VerticalAlignment="Center">
                                <Ellipse
                                    Width="8"
                                    Height="8"
                                    Fill="{ThemeResource GlassSuccessBrush}"
                                    Visibility="{x:Bind ViewModel.IsCapturing, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                                <Ellipse
                                    Width="8"
                                    Height="8"
                                    Fill="{ThemeResource GlassMutedTextBrush}"
                                    Visibility="{x:Bind ViewModel.IsCapturing, Mode=OneWay, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}" />
                            </Grid>
                            <TextBlock
                                Text="{x:Bind ViewModel.CapturePillText, Mode=OneWay}"
                                FontSize="12"
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource PreviewOnSurfaceTextBrush}"
                                VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- The two kinds of slots, as the game surface draws them. -->
            <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="16">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Rectangle Width="10" Height="10" Fill="{ThemeResource AccentFillColorDefaultBrush}" RadiusX="2" RadiusY="2" />
                    <TextBlock x:Uid="Preview/LegendCooldown" FontSize="12" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Rectangle Width="10" Height="10" Fill="{ThemeResource PreviewQuickSlotFrameBrush}" RadiusX="2" RadiusY="2" />
                    <TextBlock x:Uid="Preview/LegendQuick" FontSize="12" VerticalAlignment="Center" />
                </StackPanel>
            </StackPanel>

            <!-- Status: only what the user needs to know (a missing layout, why the background is black, how the editor works
                 and why the last pick did nothing). -->
            <StackPanel Grid.Row="4" Spacing="2">
                <TextBlock
                    Text="{x:Bind ViewModel.SlotEditMessage, Mode=OneWay}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                    TextWrapping="Wrap"
                    Visibility="{x:Bind ViewModel.HasSlotEditMessage, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                <TextBlock
                    x:Uid="Preview/SlotEditHint"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Opacity="0.7"
                    TextWrapping="Wrap" />
                <TextBlock
                    Text="{x:Bind ViewModel.LayoutStatusText, Mode=OneWay}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Opacity="0.8"
                    TextWrapping="Wrap" />
                <TextBlock
                    Text="{x:Bind ViewModel.CaptureStatusText, Mode=OneWay}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Opacity="0.7"
                    TextWrapping="Wrap" />
            </StackPanel>
        </Grid>

        <!-- The sidebar: the state of the game, the view settings and the character with its apply action. -->
        <ScrollViewer
            Grid.Column="1"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="12">

                <!-- Personaje: who the combo is applied to. It is chosen in Combos, so here it can only be changed there. -->
                <Border Style="{StaticResource SideCardStyle}">
                    <StackPanel Spacing="8">
                        <ContentControl
                            Content="{x:Bind Apply.SelectedCharacter, Mode=OneWay}"
                            ContentTemplate="{StaticResource SelectedCharacterTemplate}"
                            HorizontalContentAlignment="Left" />
                        <HyperlinkButton
                            x:Uid="Preview/ChangeCharacterButton"
                            Padding="0,2"
                            Click="ChangeCharacter_Click" />
                        <TextBlock
                            Text="{x:Bind Apply.ClassMismatchText, Mode=OneWay}"
                            Visibility="{x:Bind Apply.IsClassMismatch, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                            FontSize="12"
                            TextWrapping="Wrap"
                            Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                    </StackPanel>
                </Border>

                <!-- Casillas: how many of the 20 slots hold a skill. -->
                <Border Style="{StaticResource SideCardStyle}">
                    <StackPanel Spacing="8">
                        <Grid>
                            <TextBlock x:Uid="Preview/Slots/Header" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                            <TextBlock
                                Text="{x:Bind Apply.Editor.UsedSlotsText, Mode=OneWay}"
                                HorizontalAlignment="Right"
                                Style="{ThemeResource SubtitleTextBlockStyle}" />
                        </Grid>
                        <ProgressBar Minimum="0" Maximum="20" Value="{x:Bind Apply.Editor.UsedSlotCount, Mode=OneWay}" />
                        <TextBlock
                            x:Uid="Preview/DragHint"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Opacity="0.7"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- Te falta poner: the skills of the guide that no slot holds. Dragging a slot here takes its skill out of the slot. -->
                <Border
                    x:Name="PendingCard"
                    Style="{StaticResource SideCardStyle}"
                    BorderBrush="{ThemeResource SystemFillColorCautionBrush}"
                    AllowDrop="True"
                    DragOver="PendingCard_DragOver"
                    Drop="PendingCard_Drop">
                    <StackPanel>
                        <TextBlock x:Uid="Apply/Remaining/Title" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                        <TextBlock
                            x:Uid="Apply/Remaining/Hint"
                            FontSize="12"
                            TextWrapping="Wrap"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <ItemsControl
                            ItemsSource="{x:Bind Apply.Editor.PendingGroups, Mode=OneWay}"
                            ItemTemplate="{StaticResource PendingGroupTemplate}" />
                        <TextBlock
                            x:Uid="Apply/Remaining/Done"
                            Margin="0,10,0,0"
                            FontSize="12"
                            Foreground="{ThemeResource GlassSuccessBrush}"
                            Visibility="{x:Bind Apply.Editor.HasPending, Mode=OneWay, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}" />
                    </StackPanel>
                </Border>

                <!-- Estado: whether the game is detected, its resolution and the capture switch. -->
                <Border Style="{StaticResource SideCardStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock x:Uid="Preview/StateHeading" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Grid Width="8" Height="8" VerticalAlignment="Center">
                                <Ellipse
                                    Width="8"
                                    Height="8"
                                    Fill="{ThemeResource GlassSuccessBrush}"
                                    Visibility="{x:Bind ViewModel.IsCapturing, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                                <Ellipse
                                    Width="8"
                                    Height="8"
                                    Fill="{ThemeResource GlassMutedTextBrush}"
                                    Visibility="{x:Bind ViewModel.IsCapturing, Mode=OneWay, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}" />
                            </Grid>
                            <TextBlock
                                Text="{x:Bind ViewModel.StateText, Mode=OneWay}"
                                VerticalAlignment="Center"
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <TextBlock
                            Text="{x:Bind ViewModel.GameSizeText, Mode=OneWay}"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <ToggleSwitch
                            x:Name="CaptureToggle"
                            x:Uid="Preview/CaptureToggle"
                            IsOn="{x:Bind ViewModel.CaptureGame, Mode=TwoWay}" />
                    </StackPanel>
                </Border>

                <!-- Ajustes: the layout, the hidden slots and the view fit (three pills and the zoom). -->
                <Border Style="{StaticResource SideCardStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock x:Uid="Preview/SettingsHeading" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                        <ComboBox
                            x:Name="LayoutBox"
                            x:Uid="Preview/LayoutBox"
                            HorizontalAlignment="Stretch"
                            ItemsSource="{x:Bind ViewModel.LayoutOptions, Mode=OneTime}"
                            DisplayMemberPath="Label"
                            SelectedItem="{x:Bind ViewModel.SelectedLayoutOption, Mode=TwoWay}" />
                        <ToggleSwitch
                            x:Name="HiddenToggle"
                            x:Uid="Preview/HiddenToggle"
                            IsOn="{x:Bind ViewModel.ShowHiddenSlots, Mode=TwoWay}" />

                        <TextBlock
                            x:Uid="Preview/FitHeading"
                            Style="{ThemeResource BodyStrongTextBlockStyle}"
                            Margin="0,6,0,0" />
                        <!-- The three fits: a segmented group of pills. None is selected after a manual zoom or pan. -->
                        <StackPanel Spacing="6">
                            <Button
                                x:Uid="Preview/FitWindow"
                                Click="FitWindow_Click"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                Style="{x:Bind PillStyleFor(ViewModel.IsWindowFit), Mode=OneWay}" />
                            <Button
                                x:Uid="Preview/FitSlots"
                                Click="FitSlots_Click"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                Style="{x:Bind PillStyleFor(ViewModel.IsSlotsFit), Mode=OneWay}" />
                            <Button
                                x:Uid="Preview/FitReal"
                                Click="FitReal_Click"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                Style="{x:Bind PillStyleFor(ViewModel.IsRealFit), Mode=OneWay}" />
                        </StackPanel>

                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button
                                x:Uid="Preview/FitButton"
                                Click="Fit_Click" />
                            <TextBlock
                                Grid.Column="1"
                                Text="{x:Bind ViewModel.ZoomText, Mode=OneWay}"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Opacity="0.8" />
                        </Grid>
                        <TextBlock
                            x:Uid="Preview/FitHint"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Opacity="0.7"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
