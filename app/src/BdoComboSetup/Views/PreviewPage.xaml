<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="BdoComboSetup.Views.PreviewPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:BdoComboSetup.Views"
    xmlns:controls="using:BdoComboSetup.Views.Controls"
    xmlns:combo="using:BdoComboSetup.Core.Combo"
    xmlns:vm="using:BdoComboSetup.Core.ViewModels"
    >

    <Page.Resources>
        <!-- Compact controls on this page: buttons and combo boxes are about 30 pixels high, with 13-pixel text. -->
        <Style TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style TargetType="ComboBox" BasedOn="{StaticResource DefaultComboBoxStyle}">
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="FontSize" Value="13" />
        </Style>

        <!-- One section of the page: a card with the app's surface colors. -->
        <Style x:Key="EditorCard" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="10" />
        </Style>

        <!-- A glass card: the character, the tab panels and the state strip under the game. -->
        <Style x:Key="GlassPanelStyle" TargetType="Border" BasedOn="{StaticResource GlassCardStyle}">
            <Setter Property="Padding" Value="10" />
        </Style>

        <!-- The character shown in the sidebar: class icon and name only. -->
        <DataTemplate x:Key="SelectedCharacterTemplate" x:DataType="combo:CharacterOption">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <controls:AssetIcon
                    Monochrome="True"
                    Width="32"
                    Height="32"
                    IconSource="{x:Bind local:ApplyComboPage.ClassIconOf(ClassType), Mode=OneTime}"
                    Glyph="{x:Bind local:ApplyComboPage.ClassGlyphOf(ClassType), Mode=OneTime}" />
                <TextBlock Text="{x:Bind Name, Mode=OneTime}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </DataTemplate>

        <!-- A skill that no slot holds: drag it to a slot, or tap + for the first free slot. Its icon shows the skill's tooltip. -->
        <DataTemplate x:Key="PendingSkillTemplate" x:DataType="vm:PendingSkill">
            <Grid
                Margin="0,0,0,4"
                Padding="6,4"
                ColumnSpacing="8"
                CornerRadius="8"
                Background="{ThemeResource GlassChipBrush}"
                CanDrag="True"
                DragStarting="PendingSkill_DragStarting"
                DropCompleted="PendingSkill_DropCompleted">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <controls:AssetIcon
                    Width="26"
                    Height="26"
                    controls:SkillTooltips.Skill="{x:Bind Step.PrimarySkill, Mode=OneWay}"
                    IconSource="{x:Bind OpenIcon, Mode=OneTime}"
                    Glyph="{x:Bind Glyph, Mode=OneTime}" />
                <TextBlock
                    Grid.Column="1"
                    Text="{x:Bind Name, Mode=OneTime}"
                    FontSize="13"
                    VerticalAlignment="Center"
                    TextTrimming="CharacterEllipsis" />
                <Button
                    Grid.Column="2"
                    Content="+"
                    Padding="10,2"
                    MinHeight="0"
                    MinWidth="0"
                    Click="PendingAdd_Click" />
            </Grid>
        </DataTemplate>

        <!-- One group of pending skills: its title and count, then its skills. -->
        <DataTemplate x:Key="PendingGroupTemplate" x:DataType="vm:PendingGroup">
            <StackPanel Margin="0,8,0,0" Spacing="4">
                <Grid>
                    <TextBlock Text="{x:Bind Title, Mode=OneTime}" FontSize="11" CharacterSpacing="60" Opacity="0.75" />
                    <TextBlock Text="{x:Bind CountText, Mode=OneTime}" FontSize="11" HorizontalAlignment="Right" Opacity="0.75" />
                </Grid>
                <ItemsControl ItemsSource="{x:Bind Items, Mode=OneTime}" ItemTemplate="{StaticResource PendingSkillTemplate}" />
            </StackPanel>
        </DataTemplate>

    </Page.Resources>

    <!-- The Editor has no page header: its title and the Apply button are in the title bar. -->
    <Grid Padding="12,4,12,12">
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="300" />
            </Grid.ColumnDefinitions>

            <!-- The game and what is drawn on it: the review, the live surface, the state strip with the legend, and the status line. -->
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- The review of the character file: opened by "Apply" with the chosen parts. -->
                <Border
                    Margin="0,0,0,12"
                    Style="{StaticResource EditorCard}"
                    BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                    Visibility="{x:Bind Apply.IsReviewOpen, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Spacing="8">
                        <TextBlock x:Uid="Apply/ReviewTitle" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                        <TextBlock Text="{x:Bind Apply.ReviewSummary, Mode=OneWay}" />
                        <ListView
                            ItemsSource="{x:Bind Apply.ReviewLines, Mode=OneWay}"
                            SelectionMode="None"
                            MaxHeight="140" />
                        <TextBlock
                            x:Uid="Apply/ReviewBackupNote"
                            FontSize="12"
                            TextWrapping="Wrap"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button
                                x:Uid="Apply/WriteButton"
                                Command="{x:Bind Apply.ConfirmWriteCommand}"
                                Style="{StaticResource AccentButtonStyle}" />
                            <Button x:Uid="Apply/CancelReviewButton" Command="{x:Bind Apply.CancelReviewCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- The live game: a large glass card. The slots are drawn over the capture (black when the game is not visible),
                     and a pill in the corner says what is captured. -->
                <Border
                    Grid.Row="1"
                    Padding="0"
                    Style="{StaticResource PreviewSurfaceStyle}"
                    CornerRadius="18"
                    >
                    <Grid>
                        <local:GameScreenCanvas DataContext="{x:Bind ViewModel}" />

                        <Border
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Margin="14"
                            Padding="12,5"
                            Background="{ThemeResource PreviewOverlayBrush}"
                            BorderBrush="{ThemeResource PreviewOverlayLineBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            IsHitTestVisible="False">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Grid Width="8" Height="8" VerticalAlignment="Center">
                                    <Ellipse
                                        Width="8"
                                        Height="8"
                                        Fill="{ThemeResource GlassSuccessBrush}"
                                        Visibility="{x:Bind ViewModel.IsCapturing, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                                    <Ellipse
                                        Width="8"
                                        Height="8"
                                        Fill="{ThemeResource GlassMutedTextBrush}"
                                        Visibility="{x:Bind ViewModel.IsCapturing, Mode=OneWay, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}" />
                                </Grid>
                                <TextBlock
                                    Text="{x:Bind ViewModel.CapturePillText, Mode=OneWay}"
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    Foreground="{ThemeResource PreviewOnSurfaceTextBrush}"
                                    VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- Status: one caption line with only what the user needs to know (how the editor works and why the last pick
                     did nothing, a missing layout, why the background is black). Empty texts take no room. -->
                <StackPanel
                    Grid.Row="3"
                    Margin="0,8,0,0"
                    Orientation="Horizontal"
                    Spacing="14"
                    Visibility="{x:Bind local:PreviewPage.AnyTextVisibility(ViewModel.SlotEditMessage, ViewModel.LayoutStatusText, ViewModel.CaptureStatusText), Mode=OneWay}">
                    <TextBlock
                        Text="{x:Bind ViewModel.SlotEditMessage, Mode=OneWay}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                        TextWrapping="NoWrap"
                        Visibility="{x:Bind ViewModel.HasSlotEditMessage, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock
                        Text="{x:Bind ViewModel.LayoutStatusText, Mode=OneWay}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Opacity="0.8"
                        TextWrapping="NoWrap" />
                    <TextBlock
                        Text="{x:Bind ViewModel.CaptureStatusText, Mode=OneWay}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Opacity="0.7"
                        TextWrapping="NoWrap" />
                </StackPanel>
            </Grid>

            <!-- The side panel: the character stays on top, and one tab shows at a time below it: Casillas or Ajustes. -->
            <Grid Grid.Column="1" RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Personaje: who the combo is applied to. It is chosen in Combos, so here it can only be changed there. -->
                <Border Style="{StaticResource GlassPanelStyle}">
                    <StackPanel Spacing="8">
                        <ContentControl
                            Content="{x:Bind Apply.SelectedCharacter, Mode=OneWay}"
                            ContentTemplate="{StaticResource SelectedCharacterTemplate}"
                            HorizontalContentAlignment="Left" />
                        <HyperlinkButton
                            x:Uid="Preview/ChangeCharacterButton"
                            Padding="0,2"
                            Click="ChangeCharacter_Click" />
                        <TextBlock
                            Text="{x:Bind Apply.ClassMismatchText, Mode=OneWay}"
                            Visibility="{x:Bind Apply.IsClassMismatch, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                            FontSize="12"
                            TextWrapping="Wrap"
                            Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                    </StackPanel>
                </Border>

                <!-- The tabs: Casillas is shown first. The selected tab is kept while this page lives. -->
                <SelectorBar
                    Grid.Row="1"
                    x:Name="EditorTabs"
                    SelectionChanged="EditorTabs_SelectionChanged">
                    <SelectorBarItem x:Name="TabSlotsItem" x:Uid="Preview/TabSlots" Tag="slots" IsSelected="True" />
                    <SelectorBarItem x:Name="TabSettingsItem" x:Uid="Preview/TabSettings" Tag="settings" />
                </SelectorBar>

                <!-- The content of the selected tab. Casillas fills the rest of the panel; Ajustes scrolls on its own when it is taller. -->
                <Grid Grid.Row="2">

                    <Grid x:Name="TabSlots" RowSpacing="16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Casillas: how many of the 20 slots hold a skill. -->
                        <Border Style="{StaticResource GlassPanelStyle}">
                            <StackPanel Spacing="8">
                                <Grid>
                                    <TextBlock x:Uid="Preview/Slots/Header" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                    <TextBlock
                                        Text="{x:Bind Apply.Editor.UsedSlotsText, Mode=OneWay}"
                                        HorizontalAlignment="Right"
                                        Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                </Grid>
                                <ProgressBar
                                    x:Uid="Preview/DragHint"
                                    Minimum="0"
                                    Maximum="20"
                                    Value="{x:Bind Apply.Editor.UsedSlotCount, Mode=OneWay}" />
                            </StackPanel>
                        </Border>

                        <!-- Pending skills: the skills of the guide that no slot holds. Dragging a slot here takes its skill out of the slot. -->
                        <Border
                            Grid.Row="1"
                            x:Name="PendingCard"
                            x:Uid="Apply/Remaining/Hint"
                            Style="{StaticResource GlassPanelStyle}"
                            BorderBrush="{ThemeResource SystemFillColorCautionBrush}"
                            AllowDrop="True"
                            DragOver="PendingCard_DragOver"
                            Drop="PendingCard_Drop">
                            <Grid RowSpacing="8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock x:Uid="Apply/Remaining/Title" Style="{ThemeResource BodyStrongTextBlockStyle}" />

                                <!-- The list scrolls on its own inside the height that is left under the title. -->
                                <ScrollViewer
                                    Grid.Row="1"
                                    HorizontalScrollBarVisibility="Disabled"
                                    VerticalScrollBarVisibility="Auto">
                                    <ItemsControl
                                        ItemsSource="{x:Bind Apply.Editor.PendingGroups, Mode=OneWay}"
                                        ItemTemplate="{StaticResource PendingGroupTemplate}" />
                                </ScrollViewer>

                                <TextBlock
                                    Grid.Row="2"
                                    x:Uid="Apply/Remaining/Done"
                                    FontSize="12"
                                    Foreground="{ThemeResource GlassSuccessBrush}"
                                    Visibility="{x:Bind Apply.Editor.HasPending, Mode=OneWay, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}" />
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Ajustes: the layout and the hidden slots, then the view fit: three pills, the Fit button and the zoom. -->
                    <ScrollViewer
                        x:Name="TabSettings"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto"
                        Visibility="Collapsed">
                        <Border Style="{StaticResource GlassPanelStyle}">
                            <!-- Four sections separated by thin lines: layout, hidden slots, the game capture, the view. Each has a small
                                 title; the switches sit at the right of their label. -->
                            <StackPanel Spacing="0">
                                <StackPanel Spacing="8">
                                    <TextBlock x:Uid="Preview/SectionLayout" Style="{StaticResource CaptionTextBlockStyle}" CharacterSpacing="60" Opacity="0.7" />
                                    <ComboBox
                                        x:Name="LayoutBox"
                                        x:Uid="Preview/LayoutBox"
                                        HorizontalAlignment="Stretch"
                                        ItemsSource="{x:Bind ViewModel.LayoutOptions, Mode=OneTime}"
                                        DisplayMemberPath="Label"
                                        SelectedItem="{x:Bind ViewModel.SelectedLayoutOption, Mode=TwoWay}" />
                                </StackPanel>

                                <Border Height="1" Margin="0,14" Background="{ThemeResource GlassLineBrush}" />

                                <StackPanel Spacing="8">
                                    <TextBlock x:Uid="Preview/SectionSlots" Style="{StaticResource CaptionTextBlockStyle}" CharacterSpacing="60" Opacity="0.7" />
                                    <Grid MinHeight="32" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Uid="Preview/HiddenLabel" VerticalAlignment="Center" TextWrapping="Wrap" />
                                        <ToggleSwitch
                                            Grid.Column="1"
                                            x:Name="HiddenToggle"
                                            x:Uid="Preview/HiddenToggle"
                                            VerticalAlignment="Center"
                                            IsOn="{x:Bind ViewModel.ShowHiddenSlots, Mode=TwoWay}" />
                                    </Grid>
                                </StackPanel>

                                <Border Height="1" Margin="0,14" Background="{ThemeResource GlassLineBrush}" />

                                <!-- The game capture: the switch and the game's resolution. (The state itself is the pill on the surface.) -->
                                <StackPanel Spacing="8">
                                    <TextBlock x:Uid="Preview/SectionGame" Style="{StaticResource CaptionTextBlockStyle}" CharacterSpacing="60" Opacity="0.7" />
                                    <Grid MinHeight="32" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock x:Uid="Preview/CaptureLabel" TextWrapping="Wrap" />
                                            <TextBlock
                                                Text="{x:Bind ViewModel.GameSizeText, Mode=OneWay}"
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                Opacity="0.7" />
                                        </StackPanel>
                                        <ToggleSwitch
                                            Grid.Column="1"
                                            x:Name="CaptureToggle"
                                            x:Uid="Preview/CaptureToggle"
                                            VerticalAlignment="Center"
                                            IsOn="{x:Bind ViewModel.CaptureGame, Mode=TwoWay}" />
                                    </Grid>
                                </StackPanel>

                                <Border Height="1" Margin="0,14" Background="{ThemeResource GlassLineBrush}" />

                                <StackPanel Spacing="8">
                                    <!-- The section title and, on its right, the current zoom. -->
                                    <Grid>
                                        <TextBlock x:Uid="Preview/FitHeading" Style="{StaticResource CaptionTextBlockStyle}" CharacterSpacing="60" Opacity="0.7" />
                                        <TextBlock
                                            Text="{x:Bind ViewModel.ZoomText, Mode=OneWay}"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            HorizontalAlignment="Right"
                                            Opacity="0.7" />
                                    </Grid>
                                    <!-- The three fits: a segmented row of pills. None is selected after a manual zoom or pan. -->
                                    <Grid ColumnSpacing="6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Button
                                            x:Uid="Preview/FitWindow"
                                            Click="FitWindow_Click"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Center"
                                            Style="{x:Bind PillStyleFor(ViewModel.IsWindowFit), Mode=OneWay}" />
                                        <Button
                                            Grid.Column="1"
                                            x:Uid="Preview/FitSlots"
                                            Click="FitSlots_Click"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Center"
                                            Style="{x:Bind PillStyleFor(ViewModel.IsSlotsFit), Mode=OneWay}" />
                                        <Button
                                            Grid.Column="2"
                                            x:Uid="Preview/FitReal"
                                            Click="FitReal_Click"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Center"
                                            Style="{x:Bind PillStyleFor(ViewModel.IsRealFit), Mode=OneWay}" />
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </ScrollViewer>

                </Grid>

                <!-- The footer, always visible and in the same place as the Combos footer: writes the combo to the character. -->
                <Border Grid.Row="3" Style="{StaticResource GlassPanelStyle}" Padding="16,10,16,12">
                    <Button
                        x:Uid="Preview/ApplyButton"
                        Style="{StaticResource AccentButtonStyle}"
                        HorizontalAlignment="Stretch"
                        IsEnabled="{x:Bind Apply.CanRun, Mode=OneWay}"
                        Click="ApplyButton_Click" />
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Page>
