<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="BdoComboSetup.Views.PreviewPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:BdoComboSetup.Views"
    >

    <Grid Padding="32,24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Toolbar: layout, hidden slots, fit and zoom. Nothing else: the page shows the slots over the game. -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="16">
            <ComboBox
                x:Name="LayoutBox"
                x:Uid="Preview/LayoutBox"
                MinWidth="180"
                VerticalAlignment="Bottom"
                ItemsSource="{x:Bind ViewModel.LayoutOptions, Mode=OneTime}"
                DisplayMemberPath="Label"
                SelectedItem="{x:Bind ViewModel.SelectedLayoutOption, Mode=TwoWay}" />
            <ToggleSwitch
                x:Name="HiddenToggle"
                x:Uid="Preview/HiddenToggle"
                IsOn="{x:Bind ViewModel.ShowHiddenSlots, Mode=TwoWay}" />
            <Button
                x:Uid="Preview/FitButton"
                VerticalAlignment="Bottom"
                Click="Fit_Click" />
            <TextBlock
                Text="{x:Bind ViewModel.ZoomText, Mode=OneWay}"
                VerticalAlignment="Bottom"
                Opacity="0.8" />
        </StackPanel>

        <!-- The slots over the live game capture (black when the game is not visible). -->
        <local:GameScreenCanvas
            Grid.Row="1"
            DataContext="{x:Bind ViewModel}" />

        <!-- Status: only what the user needs to know (a missing layout, or why the background is black). -->
        <StackPanel Grid.Row="2" Spacing="2">
            <TextBlock
                Text="{x:Bind ViewModel.LayoutStatusText, Mode=OneWay}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Opacity="0.8"
                TextWrapping="Wrap" />
            <TextBlock
                Text="{x:Bind ViewModel.CaptureStatusText, Mode=OneWay}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Opacity="0.7"
                TextWrapping="Wrap" />
        </StackPanel>
    </Grid>
</Page>
